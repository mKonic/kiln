#!/usr/bin/env python3
"""Writes Registry.gen.cpp: the androidx material3 catalog's components and examples
(Components.kt, Examples.kt) with each example bound to its kiln port in samples/, or to a
placeholder while the sample is not ported.

usage: samples/catalog/gen-registry <androidx-compose checkout> <material-icons sources>
A sample counts as ported when samples/*.h declares `void <SampleName>();`. It also writes
gen/Icons.h/.cpp (tools/icongen --icons) with every Icons::<Theme>::<Name>() the sources use;
<material-icons sources> is the unpacked material-icons-core and -extended sources jars.
"""
import glob, os, re, subprocess, sys

here = os.path.dirname(os.path.abspath(__file__))
lib = os.path.join(sys.argv[1], "compose/material3/material3/integration-tests/material3-catalog/src/main/java/"
                   "androidx/compose/material3/catalog/library/model")
comp = open(os.path.join(lib, "Components.kt")).read()
ex = open(os.path.join(lib, "Examples.kt")).read()
consts = dict(re.findall(r'(?:private )?const val (\w+) =\s*"([^"]*)"', ex + comp))


def string(expr):
    """A Kotlin string expression of literals, constants and `+`; templates keep their text."""
    out = ""
    for part in re.findall(r'"((?:[^"\\]|\\.)*)"|(\w+)', expr):
        lit, name = part
        if name:
            out += consts.get(name, "")
        else:
            lit = re.sub(r"\$\{?(\w+)\}?", lambda m: consts.get(m.group(1), m.group(0)), lit)
            out += re.sub(r"\\(.)", lambda m: {"n": "\n", "t": "\t"}.get(m.group(1), m.group(1)), lit)
    return out


def arg(body, name):
    m = re.search(r"\b" + name + r"\s*=\s*(.*?)(?:,\s*\n\s*(?=\w+\s*=)|,?\s*$)", body, re.S)
    return m.group(1).strip() if m else None


def call_body(text, start):
    depth, i = 1, start
    while depth:
        depth += {"(": 1, ")": -1}.get(text[i], 0)
        i += 1
    return text[start:i - 1], i


lists = {}
for m in re.finditer(r"val (\w+Examples)\s*=", ex):
    lo = ex.find("listOf(", m.end())
    nxt = re.search(r"\n(?:private )?val \w+", ex[m.end():])
    if lo < 0 or (nxt and lo > m.end() + nxt.start()):
        continue
    body, _ = call_body(ex, lo + len("listOf("))
    items = []
    for em in re.finditer(r"Example\(", body):
        args, end = call_body(body, em.end())
        lam = re.match(r"\s*\{\s*(\w+)\(", body[end:])
        items.append({"name": string(arg(args, "name")), "description": string(arg(args, "description") or '""'),
                      "expressive": (arg(args, "isExpressive") or "false") == "true",
                      "sample": lam.group(1) if lam else None})
    # A `.map { it.copy(content = { Box(Modifier.wrapContentWidth().width(N.dp)) { it.content() } }) }`
    # after the list wraps every example (the text field samples get 280 dp).
    _, after = call_body(ex, lo + len("listOf("))
    width = 0
    if re.match(r"\s*\.map\s*\{", ex[after:]):
        wm = re.match(r"\s*\.map\s*\{(?:\s*//[^\n]*)*\s*it\.copy\(content = \{ Box\(Modifier\.wrapContentWidth\(\)\.width\((\d+)\.dp\)\) "
                      r"\{ it\.content\(\) \} \}\)\s*\}", ex[after:])
        if not wm:
            sys.exit(f"gen-registry: {m.group(1)} maps its examples in a way this script does not know")
        width = int(wm.group(1))
    lists[m.group(1)] = {"items": items, "width": width}

comps = {}
for m in re.finditer(r"private val (\w+) =\s*Component\(", comp):
    args, _ = call_body(comp, m.end())
    comps[m.group(1)] = {"name": string(arg(args, "name")), "description": string(arg(args, "description")),
                         "examples": arg(args, "examples"), "tint": (arg(args, "tintIcon") or "true") == "true"}
order = [x.strip() for x in re.search(r"val Components\s*=\s*listOf\((.*?)\)", comp, re.S).group(1).split(",") if x.strip()]

ported = set()
for h in glob.glob(os.path.join(here, "samples", "*.h")):
    ported |= set(re.findall(r"void (\w+)\(\);", open(h).read()))


def c(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'


out = ["// Generated by samples/catalog/gen-registry from the androidx material3 catalog. Do not edit.", "",
       '#include "Catalog.h"']
out += [f'#include "samples/{os.path.basename(h)}"' for h in sorted(glob.glob(os.path.join(here, "samples", "*.h")))]
out += ["", "namespace catalog {", "", "    const std::vector<Component>& Components() {",
        "        static const std::vector<Component> components = {"]
total = done = 0
# nextId() runs as each `private val X = Component(...)` initialises: declaration order.
ids = {v: i for i, v in enumerate(comps, 1)}
for v in order:
    cm = comps[v]
    i = ids[v]
    lst = lists.get(cm["examples"], {"items": [], "width": 0})
    out.append(f"            {{ {i}, {c(cm['name'])}, {c(cm['description'])}, {'true' if cm['tint'] else 'false'}, {lst['width']}, {{")
    for e in lst["items"]:
        total += 1
        fn = e["sample"] if e["sample"] in ported else None
        done += fn is not None
        out.append(f"                {{ {c(e['name'])}, {c(e['description'])}, {'true' if e['expressive'] else 'false'}, "
                   f"{'samples::' + fn if fn else 'nullptr'} }},")
    out.append("            } },")
out += ["        };", "        return components;", "    }", "", "}", ""]
open(os.path.join(here, "Registry.gen.cpp"), "w").write("\n".join(out))
print(f"{len(order)} components, {done} of {total} examples ported")

icons = set()
for f in glob.glob(os.path.join(here, "*.cpp")) + glob.glob(os.path.join(here, "samples", "*.cpp")):
    for m in re.finditer(r"\bIcons::((?:AutoMirrored::)?(?:Filled|Outlined|Rounded|Sharp|TwoTone|Default))::(\w+)\(\)", open(f).read()):
        icons.add(m.group(1).replace("::", ".").replace("Default", "Filled") + "." + m.group(2))
subprocess.run([os.path.join(here, "..", "..", "tools", "icongen"), "--icons", sys.argv[2], "catalog",
                os.path.join(here, "gen")] + sorted(icons), check=True)
