<?xml version="1.0" encoding="utf-8"?>
<!-- kiln::glance: a widget whose content threw (glance-appwidget layout/glance_error_layout.xml with Glance.AppWidget.Background.Error on API 31); KilnWidgetReceiver sets the text in the launcher's language. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:clipToOutline="true" android:background="@drawable/kiln_glance_error_background">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:id="@+id/kiln_glance_error_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_weight="1" android:text="Can't show content" android:textColor="@color/kiln_glance_colorOnSurface" />
    </FrameLayout>
</LinearLayout>
