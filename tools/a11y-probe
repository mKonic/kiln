#!/usr/bin/env bash
# a11y-probe: reads and drives the foreground app's accessibility tree through UiAutomation, the
# way TalkBack or Switch Access would (adb input skips the touch explorer, so this is the way to
# exercise AccessibilityNodeProvider actions from a script).
#
#   tools/a11y-probe "dump; click:Tap me; settext:Edit me=hello; wait:300; dump"
#
# Verbs: dump, vdump (with actions and traversal), show:<text>, word:/char:/line:/para:<text> (next
# at that granularity), chars:<text> (character locations), action:<text>=<label> (custom), click:<text>, longclick:<text>, focus:<text>, a11yfocus:<text>,
# settext:<text>=<value>, setprogress:<text>=<float>, wait:<ms>, swipe:<x1,y1,x2,y2,ms>,
# swipeon:<text>=<dx,dy,ms> (a drag from its centre, in dp),
# scroll:<n> / scrollback:<n> (the n-th scrollable node), clip (the
# clipboard's text). <text> matches a node's text or content description.
# Checks, for one run per scenario: expect:<text> / reject:<text> (wait up to 3 s for a visible
# node to appear / go away; a failure stops the run with a dump and exit status 1),
# reach:<text> (scroll it into the upper half), tap:<text> / press:<text>[=ms] (a real touch at
# its centre), back, shot:<name> (a screenshot; PROBE_SHOTS=<dir> pulls them, default build/shots).
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/android-env.sh"
APK="$KILN_ROOT/build/a11y-probe.apk"
SRC="$KILN_ROOT/tools/a11y-probe-src"
if [ ! -f "$APK" ] || [ -n "$(find "$SRC" -newer "$APK" -name '*.java')" ]; then
    S="$KILN_ROOT/build/pack/a11y-probe"; rm -rf "$S"; mkdir -p "$S/classes" "$S/dex"
    javac --release 17 -nowarn -classpath "$ANDROID_JAR" -d "$S/classes" $(find "$SRC" -name '*.java')
    "$D8" --min-api "$ANDROID_MIN_SDK" --lib "$ANDROID_JAR" --output "$S/dex" $(find "$S/classes" -name '*.class')
    cp "$S/dex/classes.dex" "$S/classes.dex"
    cat > "$S/AndroidManifest.xml" <<XML
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.kiln.probe">
    <application android:hasCode="true" />
    <instrumentation android:name="dev.kiln.probe.Probe" android:targetPackage="dev.kiln.probe" />
</manifest>
XML
    "$AAPT2" link -o "$S/unsigned.apk" -I "$ANDROID_JAR" --manifest "$S/AndroidManifest.xml" \
        --min-sdk-version "$ANDROID_MIN_SDK" --target-sdk-version "$ANDROID_TARGET_SDK"
    python3 "$KILN_ROOT/tools/apkzip.py" "$S/unsigned.apk" "$S" classes.dex
    "$ZIPALIGN" -f 4 "$S/unsigned.apk" "$S/aligned.apk"
    "$APKSIGNER" sign --ks "$KILN_ROOT/build/kiln-debug.keystore" --ks-key-alias kiln --ks-pass pass:android \
        --key-pass pass:android --out "$APK" "$S/aligned.apk"
    adb install -r "$APK" >/dev/null
fi
files=/sdcard/Android/data/dev.kiln.probe/files
adb shell rm -f "$files/*.png" 2>/dev/null || true
result="$(adb shell am instrument -w -e cmd "'${1:-dump}'" dev.kiln.probe/.Probe)"
printf '%s\n' "$result"
if adb shell ls "$files" 2>/dev/null | grep -q '\.png'; then
    mkdir -p "${PROBE_SHOTS:-$KILN_ROOT/build/shots}"
    adb pull -q "$files/." "${PROBE_SHOTS:-$KILN_ROOT/build/shots}" >/dev/null
fi
! grep -q '^FAILED ' <<<"$result"
