#!/usr/bin/env bash
# kiln: from source to a running app in one command.
#
#   kiln new <name> [--package id] [--label text]
#                                   a new app in apps/<name> (its own folder: CMakeLists.txt,
#                                   src/main.cpp, assets/, res/icon.png)
#   kiln list                       the apps this tree builds (samples and apps/)
#   kiln build <app> [opts]         configure and build the app's library for each ABI
#   kiln apk <app> [opts]           ... and pack it: build/apk/<app>.apk (or --out)
#   kiln run <app> [opts]           ... install it and start it
#   kiln version                    the kiln version this tree is at
#   kiln update [version]           move the tree to a release (the newest, or the one named):
#                                   kiln is built from source with each app, so this is the update
#
#   --abi a[,b]   ABIs (default: the device's for run, otherwise arm64-v8a,x86_64)
#   --debug       a debuggable APK that answers Volition (content://<package>.volition)
#   --release     an optimised APK for publishing (the default), signed with
#                 --keystore file --key-alias name when given (passwords from
#                 KILN_KEYSTORE_PASSWORD / KILN_KEY_PASSWORD), else with kiln's debug key
#   --lto         link-time optimisation: a 4-5% smaller library, a slower build, the same speed
#   --out file    where apk writes the APK
#
# The device is adb's: set ANDROID_SERIAL when more than one is attached.
set -euo pipefail
for a in "$@"; do [ "$a" = --lto ] && export KILN_LTO=1; done
source "$(dirname "${BASH_SOURCE[0]}")/android-env.sh"

usage() { sed -n '2,24p' "$0" >&2; exit 2; }
[ $# -ge 1 ] || usage
CMD="$1"; shift
APP=""; ABIS=""; DEBUG=(); OUT=""; NEW_PACKAGE=""; NEW_LABEL=""; SIGN=()
while [ $# -gt 0 ]; do
    case "$1" in
        --abi) ABIS="$2"; shift 2 ;;
        --debug) DEBUG=(--debug); shift ;;
        --release) DEBUG=(); shift ;;
        --lto) shift ;;
        --keystore) SIGN+=(--keystore "$2"); shift 2 ;;
        --key-alias) SIGN+=(--key-alias "$2"); shift 2 ;;
        --package) NEW_PACKAGE="$2"; shift 2 ;;
        --label) NEW_LABEL="$2"; shift 2 ;;
        --out) OUT="$2"; shift 2 ;;
        -h|--help) usage ;;
        -*) echo "kiln: unknown option $1" >&2; exit 2 ;;
        *) [ -z "$APP" ] || usage; APP="$1"; shift ;;
    esac
done

# An app's metadata, written by kiln_add_android_app at configure time.
meta() { sed -n "s/^$2=//p" "$KILN_ANDROID_BUILD/$1/apps/$APP"; }

if [ "$CMD" = new ]; then
    [ -n "$APP" ] || usage
    [[ "$APP" =~ ^[a-z][a-z0-9_-]*$ ]] || { echo "kiln: an app name is lower case letters, digits, - and _" >&2; exit 2; }
    dir="$KILN_ROOT/apps/$APP"
    [ ! -e "$dir" ] || { echo "kiln: $dir already exists" >&2; exit 1; }
    for taken in hello list gallery notes-c notes-cpp catalog; do
        [ "$APP" != "$taken" ] || { echo "kiln: '$APP' is one of kiln's samples" >&2; exit 1; }
    done
    package="${NEW_PACKAGE:-com.example.${APP//[-_]/}}"
    label="${NEW_LABEL:-$APP}"
    python3 "$KILN_ROOT/tools/kiln-new.py" "$dir" "$APP" "$package" "$label"
    echo "kiln: created apps/$APP ($package). Run it: tools/kiln run $APP"
    exit 0
fi

if [ "$CMD" = version ]; then
    exec "$KILN_ROOT/scripts/version.sh" name
fi

if [ "$CMD" = update ]; then
    cd "$KILN_ROOT"
    git fetch --quiet --tags origin
    target="${APP:-$(git tag --list 'v[0-9]*' --sort=-v:refname | head -1)}"
    [ -n "$target" ] || { echo "kiln: no releases yet" >&2; exit 1; }
    git rev-parse --verify --quiet "refs/tags/$target" >/dev/null || { echo "kiln: no release '$target' (git tag --list 'v*' shows them)" >&2; exit 1; }
    # Apps in apps/ are not kiln's files; only changes to kiln itself are in the way.
    [ -z "$(git status --porcelain --untracked-files=no)" ] || {
        echo "kiln: this tree has changes to kiln's own files; commit or stash them first" >&2; exit 1; }
    from="$(git describe --tags --always)"
    git checkout --quiet "$target"
    git submodule update --quiet --init --recursive
    echo "kiln: $from -> $target. The next build rebuilds kiln with your apps."
    exit 0
fi

if [ "$CMD" = list ]; then
    abi=arm64-v8a
    [ -d "$KILN_ANDROID_BUILD/$abi/apps" ] || kiln_configure_android "$abi"
    for f in "$KILN_ANDROID_BUILD/$abi/apps"/*; do
        printf '%-12s %s\n' "$(basename "$f")" "$(sed -n 's/^package=//p' "$f")"
    done
    exit 0
fi
case "$CMD" in build|apk|run) ;; *) usage ;; esac
[ -n "$APP" ] || usage

if [ -z "$ABIS" ]; then
    if [ "$CMD" = run ]; then
        ABIS="$("$ADB" shell getprop ro.product.cpu.abi | tr -d '\r')"
        [ -n "$ABIS" ] || { echo "kiln: no device (adb shell getprop failed)" >&2; exit 1; }
    else
        ABIS="arm64-v8a,x86_64"
    fi
fi
IFS=, read -r -a ABI_LIST <<< "$ABIS"

LIB_ARGS=()
for abi in "${ABI_LIST[@]}"; do
    kiln_configure_android "$abi"
    [ -f "$KILN_ANDROID_BUILD/$abi/apps/$APP" ] || {
        echo "kiln: no app '$APP' - kiln list shows them" >&2; exit 1; }
    # --debug: the library with Volition's commands linked in.
    if [ ${#DEBUG[@]} -gt 0 ]; then target="${APP}_debug"; key=lib_debug; else target="$APP"; key=lib; fi
    cmake --build "$KILN_ANDROID_BUILD/$abi" --target "$target"
    LIB_ARGS+=(--lib "$abi=$(meta "$abi" "$key")")
done
[ "$CMD" = build ] && exit 0

first="${ABI_LIST[0]}"
PACKAGE="$(meta "$first" package)"; LABEL="$(meta "$first" label)"; ASSETS="$(meta "$first" assets)"
APK="${OUT:-$KILN_ROOT/build/apk/$APP.apk}"
PACK=(); [ -n "$ASSETS" ] && PACK+=(--assets "$ASSETS")
v="$(meta "$first" icon)"; [ -n "$v" ] && PACK+=(--icon "$v")
v="$(meta "$first" version_code)"; [ -n "$v" ] && PACK+=(--version-code "$v")
v="$(meta "$first" version_name)"; [ -n "$v" ] && PACK+=(--version-name "$v")
v="$(meta "$first" manifest_xml)"; [ -n "$v" ] && PACK+=(--manifest-xml "$v")
v="$(meta "$first" application_xml)"; [ -n "$v" ] && PACK+=(--application-xml "$v")
IFS=, read -r -a perms <<< "$(meta "$first" permissions)"
for p in "${perms[@]}"; do [ -n "$p" ] && PACK+=(--permission "$p"); done
"$KILN_ROOT/tools/kiln-pack" --package "$PACKAGE" --label "$LABEL" --lib-name "$APP" "${LIB_ARGS[@]}" \
    "${PACK[@]}" "${DEBUG[@]}" "${SIGN[@]}" --out "$APK"
[ "$CMD" = apk ] && exit 0

"$ADB" install -r "$APK" >/dev/null
"$ADB" shell am start -W -n "$PACKAGE/dev.kiln.KilnActivity" | grep -E 'Status|TotalTime'
