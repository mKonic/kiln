#!/usr/bin/env python3
"""Generates kiln's material3 internal icons from androidx material3's internal/Icons.kt.

usage: tools/icongen <androidx-compose checkout> <output dir>

Each `val Name: ImageVector` in the Kotlin `Icons` object (nested objects AutoMirrored.Filled,
Filled, Outlined) becomes a function in kiln::material3::internal::Icons::<objects> returning
a cached gfx::vector::ImageVectorPtr. Understood forms: materialIcon(name =, autoMirror =) with
materialPath { ... } or path(fill = SolidColor(Color.Black), fillAlpha =, pathFillType =, ...)
blocks, and an explicit ImageVector.Builder(name =, defaultWidth =, ...). Path builder calls
map one to one onto gfx::vector::PathBuilder. Anything else stops the run with the line, so a
new form is added here rather than dropped.
"""
import os, re, sys

SOURCE = "compose/material3/material3/src/commonMain/kotlin/androidx/compose/material3/internal/Icons.kt"
CALLS = {
    "moveTo": 2, "moveToRelative": 2, "lineTo": 2, "lineToRelative": 2,
    "horizontalLineTo": 1, "horizontalLineToRelative": 1, "verticalLineTo": 1, "verticalLineToRelative": 1,
    "curveTo": 6, "curveToRelative": 6, "reflectiveCurveTo": 4, "reflectiveCurveToRelative": 4,
    "quadTo": 4, "quadToRelative": 4, "reflectiveQuadTo": 2, "reflectiveQuadToRelative": 2,
    "arcTo": 7, "arcToRelative": 7, "close": 0,
}


def fail(line_no, text):
    sys.exit(f"{SOURCE}:{line_no}: not understood: {text.strip()}")


def cpp_float(token, line_no, text):
    token = token.strip()
    if token in ("true", "false"):
        return token
    m = re.fullmatch(r"(-?)(\d+)(\.\d+)?f?", token)
    if not m:
        fail(line_no, text)
    return f"{m.group(1)}{m.group(2)}{m.group(3) or '.0'}f"


def main():
    root, out = sys.argv[1], sys.argv[2]
    lines = open(os.path.join(root, SOURCE), encoding="utf-8").read().split("\n")
    objects = []          # nesting of `object X {` names below Icons
    depth_of = []         # brace depth at which each object opened
    depth = 0
    icons = []            # (namespace path, name, display name, autoMirror, [paths])
    current = None        # icon being read
    path = None           # path being read: dict
    for no, text in enumerate(lines, 1):
        s = text.strip()
        before = depth
        depth += s.count("{") - s.count("}")
        while depth_of and depth < depth_of[-1]:
            objects.pop()
            depth_of.pop()
        m = re.match(r"internal object (\w+) \{", s)
        if m:
            if m.group(1) != "Icons":
                objects.append(m.group(1))
                depth_of.append(depth)
            continue
        m = re.match(r"(?:internal )?val (\w+): ImageVector$", s)
        if m:
            current = {"ns": list(objects), "name": m.group(1), "display": None, "mirror": False, "paths": []}
            icons.append(current)
        elif current is not None and path is None:
            m = re.search(r'name = "([^"]+)"', s)
            if m:
                current["display"] = m.group(1)
            if re.search(r"autoMirror = true", s):
                current["mirror"] = True
            if s.startswith("materialPath {") or s.startswith("materialPath(") or s.startswith("path("):
                path = {"alpha": "1.0f", "fill": "NonZero", "calls": [], "header": s.startswith("path(") or s.startswith("materialPath(")}
                if not path["header"]:
                    path["header"] = False
                continue
        if path is not None:
            if path["header"]:
                m = re.match(r"fillAlpha = ([\d.]+f?),", s)
                if m:
                    path["alpha"] = cpp_float(m.group(1), no, text)
                m = re.match(r"pathFillType = PathFillType\.(?:Companion\.)?(\w+),", s)
                if m:
                    path["fill"] = m.group(1)
                if s.endswith(") {"):
                    path["header"] = False
                continue
            if s == "}":
                current["paths"].append(path)
                path = None
                continue
            m = re.fullmatch(r"(\w+)\((.*)\)", s)
            if not m or m.group(1) not in CALLS:
                fail(no, text)
            args = [a for a in m.group(2).split(",") if a.strip()]
            if len(args) != CALLS[m.group(1)]:
                fail(no, text)
            path["calls"].append((m.group(1), [cpp_float(a, no, text) for a in args]))
            continue
    for icon in icons:
        if not icon["paths"]:
            sys.exit(f"{SOURCE}: icon {icon['name']} has no paths")

    def ns_open(ns):
        return "".join(f"namespace {n} {{ " for n in ns)

    os.makedirs(out, exist_ok=True)
    h = ["#pragma once", "",
         "// Generated by tools/icongen from androidx material3 internal/Icons.kt. Do not edit.",
         "// The icons material3 components draw (24 dp, viewport 24).", "",
         '#include "kiln/graphics/vector/ImageVector.h"', "",
         "namespace kiln::material3::internal::Icons {", "",
         "    using gfx::vector::ImageVectorPtr;", ""]
    c = ['// Generated by tools/icongen from androidx material3 internal/Icons.kt. Do not edit.', "",
         '#include "kiln/material3/internal/Icons.h"', "",
         "namespace kiln::material3::internal::Icons {", "",
         "    using namespace gfx::vector;", ""]
    for icon in icons:
        ns = icon["ns"]
        close = "}" * len(ns)
        h.append(f"    {ns_open(ns)}const ImageVectorPtr& {icon['name']}(); {close}")
        body = [f"    {ns_open(ns)}const ImageVectorPtr& {icon['name']}() {{",
                "        static const ImageVectorPtr image = [] {",
                f'            ImageVector::Builder b("{icon["display"] or icon["name"]}", ui::Dp(24), ui::Dp(24), 24, 24, '
                f'ui::Color::Unspecified(), gfx::BlendMode::SrcIn, {"true" if icon["mirror"] else "false"});']
        for p in icon["paths"]:
            body.append("            b.Path(PathBuilder()")
            for name, args in p["calls"]:
                body.append(f"                       .{name[0].upper() + name[1:]}({', '.join(args)})")
            body.append(f"                       .Nodes(), gfx::Brush::SolidColor(ui::Color(0xff000000)), {p['alpha']}, std::nullopt, 1.0f, 1.0f,")
            body.append(f"                   gfx::StrokeCap::Butt, gfx::StrokeJoin::Bevel, 1.0f, gfx::FillType::{p['fill']});")
        body += ["            return b.Build();", "        }();", "        return image;", f"    }} {close}", ""]
        c += body
    h += ["", "}", ""]
    c += ["}", ""]
    open(os.path.join(out, "Icons.h"), "w").write("\n".join(h))
    open(os.path.join(out, "Icons.cpp"), "w").write("\n".join(c))
    print(f"{len(icons)} icons")


if __name__ == "__main__":
    main()
