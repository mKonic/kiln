#!/usr/bin/env python3
"""Generates material3's string table (material3/internal/Strings.android.kt) for kiln.

usage: tools/gen-m3-strings <androidx-compose checkout> <material3 src dir>

Writes kiln/material3/internal/Strings.h (the Strings ids, in the order Strings.android.kt
declares them) and StringsTable.cpp (each id's value per locale from the resources it names:
material3's res for MaterialR.string, Compose ui's res for R.string).
"""
import os, re, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from android_res import read_tables, cstr

compose = os.path.join(sys.argv[1], "compose")
out = os.path.join(sys.argv[2], "kiln/material3/internal")
kt = os.path.join(compose, "material3/material3/src/androidMain/kotlin/androidx/compose/material3/internal/Strings.android.kt")
src = open(kt).read()
ids = re.findall(r"actual inline val (\w+)\s+get\(\) = Strings\((MaterialR|R)\.string\.(\w+)\)", src)
if len(ids) != src.count("get() = Strings("):
    sys.exit("gen-m3-strings: Strings.android.kt has an entry form this script does not read")

material = read_tables(os.path.join(compose, "material3/material3/src/androidMain/res"))
ui = read_tables(os.path.join(compose, "ui/ui/src/androidMain/res"))

# adaptive-layout's Strings (Strings.android.kt there, its own res), appended as Adaptive*.
akt = os.path.join(compose, "material3/adaptive/adaptive-layout/src/androidMain/kotlin/androidx/compose/material3/adaptive/layout/internal/Strings.android.kt")
asrc = open(akt).read()
aids = re.findall(r"actual (?:inline )?val (\w+)(?:: Strings)?\s+get\(\) =\s*Strings\(\s*R\.string\.(\w+)\s*\)", asrc)
if len(aids) != asrc.count("get() ="):
    sys.exit("gen-m3-strings: adaptive Strings.android.kt has an entry form this script does not read")
adaptive = read_tables(os.path.join(compose, "material3/adaptive/adaptive-layout/src/androidMain/res"))
ids += [("Adaptive" + n[0].upper() + n[1:], "AdaptiveR", k) for n, k in aids]

def value(tables, tag, name):
    return tables.get(tag, {}).get(name)

def tables_of(res):
    return material if res == "MaterialR" else adaptive if res == "AdaptiveR" else ui

tags = sorted(set(material) | set(ui) | set(adaptive))
for name, res, key in ids:
    if value(tables_of(res), "", key) is None:
        sys.exit(f"gen-m3-strings: no default value for {res}.string.{key}")

os.makedirs(out, exist_ok=True)
h = ["#pragma once", "",
     "// Generated by tools/gen-m3-strings from material3's and adaptive-layout's Strings.android.kt. Do not edit.",
     "// material3's Strings: ids of the strings components read (getString).", "",
     "#include <cstdint>", "",
     "namespace kiln::material3 {", "",
     "    enum class Strings : std::uint16_t {"]
for name, res, key in ids:
    h.append(f"        {name},   // {res}.string.{key}")
h += ["    };", f"    inline constexpr int kStringsCount = {len(ids)};", "", "}"]
open(os.path.join(out, "Strings.h"), "w").write("\n".join(h) + "\n")

c = ["// Generated by tools/gen-m3-strings from material3's and Compose ui's values*/strings.xml. Do not edit.", "",
     '#include "kiln/material3/internal/Strings.h"', "",
     "#include <string_view>", "",
     "namespace kiln::material3::internal {", "",
     "    struct StringsEntry { const char* tag; const char* values[kStringsCount]; };",
     "    // nullptr: the locale has no value of its own for that id (the next candidate's is used).",
     "    extern const StringsEntry kStringsTable[];",
     "    extern const int kStringsTableSize;", "",
     "    const StringsEntry kStringsTable[] = {"]
count = 0
for tag in tags:
    vals = []
    for name, res, key in ids:
        v = value(tables_of(res), tag, key)
        vals.append(cstr(v) if v is not None else "nullptr")
    if tag and all(v == "nullptr" for v in vals):
        continue
    c.append(f"        {{ {cstr(tag)}, {{ {', '.join(vals)} }} }},")
    count += 1
c += ["    };", f"    const int kStringsTableSize = {count};", "", "}"]
open(os.path.join(out, "StringsTable.cpp"), "w").write("\n".join(c) + "\n")
print(f"gen-m3-strings: {len(ids)} strings, {count} locales", file=sys.stderr)
