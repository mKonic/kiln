#!/usr/bin/env python3
"""Generates kiln::glance's error-view text (glance-appwidget's glance_error_layout_text_v2) for kiln.

usage: tools/gen-glance-strings <androidx-compose checkout>

Writes platform/android/java/dev/kiln/KilnGlanceStrings.java: the text per locale tag, which
KilnGlance's error view picks for the launcher's locales. kiln keeps these out of its res/ (the
values-<language> folders would read as the app's own languages in kiln-pack).
"""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from android_res import read_tables

root = os.path.join(sys.argv[1], "glance/glance-appwidget/src/main/res")
tables = read_tables(root)
key = "glance_error_layout_text_v2"
if tables.get("", {}).get(key) is None:
    sys.exit("gen-glance-strings: no default value for " + key)

def jstr(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'

out = ["// Generated by tools/gen-glance-strings from glance-appwidget's values*/strings.xml. Do not edit.",
       "package dev.kiln;", "",
       "import java.util.HashMap;", "import java.util.Map;", "",
       "/** glance_error_layout_text_v2 per locale tag (\"\" the default). */",
       "final class KilnGlanceStrings {",
       "    static final Map<String, String> ERROR_TEXT = new HashMap<>();",
       "    static {"]
count = 0
for tag in sorted(tables):
    v = tables[tag].get(key)
    if v is None:
        continue
    out.append(f"        ERROR_TEXT.put({jstr(tag)}, {jstr(v)});")
    count += 1
out += ["    }", "", "    private KilnGlanceStrings() {}", "}"]
dst = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "platform/android/java/dev/kiln/KilnGlanceStrings.java")
open(dst, "w").write("\n".join(out) + "\n")
print(f"gen-glance-strings: {count} locales", file=sys.stderr)
