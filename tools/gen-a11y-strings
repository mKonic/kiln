#!/usr/bin/env python3
"""Generates core/src/kiln/ui/AccessibilityStrings.cpp from Compose ui's string resources
(androidx-compose/compose/ui/ui/src/androidMain/res/values*/strings.xml): the strings the
accessibility delegate speaks, per locale.

usage: tools/gen-a11y-strings <androidx-compose checkout> > core/src/kiln/ui/AccessibilityStrings.cpp
"""
import os, re, sys, xml.etree.ElementTree as ET

KEYS = [("state_on", "stateOn"), ("state_off", "stateOff"), ("indeterminate", "indeterminate"),
        ("selected", "selected"), ("not_selected", "notSelected"), ("template_percent", "templatePercent"),
        ("in_progress", "inProgress"), ("state_empty", "stateEmpty"), ("tab", "tab"), ("switch_role", "switchRole")]

def text_of(el):
    s = "".join(el.itertext())
    s = s.strip()
    if len(s) >= 2 and s[0] == '"' and s[-1] == '"':
        s = s[1:-1]
    return s.replace("\\'", "'").replace('\\"', '"')

def tag_of(folder):
    q = folder[len("values"):].lstrip("-")
    if not q:
        return ""
    parts = q.split("-")
    if parts[0] == "b+":
        return None
    if q.startswith("b+"):
        return "-".join(q[2:].split("+"))
    out = [parts[0]]
    for p in parts[1:]:
        out.append(p[1:] if p.startswith("r") and len(p) == 3 else p)
    return "-".join(out)

def cstr(s):
    return '"' + s.encode("utf-8").decode("utf-8").replace("\\", "\\\\").replace('"', '\\"') + '"'

root = os.path.join(sys.argv[1], "compose/ui/ui/src/androidMain/res")
tables = {}
for folder in sorted(os.listdir(root)):
    if not folder.startswith("values"):
        continue
    path = os.path.join(root, folder, "strings.xml")
    if not os.path.exists(path):
        continue
    tag = tag_of(folder)
    if tag is None:
        continue
    values = {}
    for el in ET.parse(path).getroot().iter("string"):
        values[el.get("name")] = text_of(el)
    if any(k in values for k, _ in KEYS):
        tables[tag] = values

print("// Generated by tools/gen-a11y-strings from Compose ui's values*/strings.xml. Do not edit.")
print()
print('#include "kiln/ui/Accessibility.h"')
print()
print("#include <cstring>")
print()
print("namespace kiln::ui::a11y {")
print()
print("    namespace {")
print("        struct Entry { const char* tag; const char* values[%d]; };" % len(KEYS))
print("        constexpr Entry kTable[] = {")
default = tables[""]
for tag in sorted(tables):
    v = tables[tag]
    vals = ", ".join(cstr(v.get(k, default[k])) for k, _ in KEYS)
    print("            { %s, { %s } }," % (cstr(tag), vals))
print("        };")
print("        const Entry* Lookup(const std::string& tag) {")
print("            for (const Entry& e : kTable) if (tag == e.tag) return &e;")
print("            return nullptr;")
print("        }")
print("    }")
print()
print("    Strings Strings::ForLocale(const std::string& tag) {")
print("        // The exact tag, then the language, then the default.")
print("        const Entry* e = Lookup(tag);")
print("        if (!e) if (auto dash = tag.find('-'); dash != std::string::npos) e = Lookup(tag.substr(0, dash));")
print("        if (!e) e = Lookup(\"\");")
print("        Strings s;")
for i, (_, field) in enumerate(KEYS):
    print("        s.%s = e->values[%d];" % (field, i))
print("        return s;")
print("    }")
print()
print("}")
