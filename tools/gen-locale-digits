#!/usr/bin/env python3
"""Generates core/src/kiln/text/LocaleDigits.cpp from CLDR: the zero digit of each locale's default
numbering system (what java.text.DecimalFormatSymbols.getZeroDigit gives String.format's %d).

usage: tools/gen-locale-digits <cldr-json checkout> > core/src/kiln/text/LocaleDigits.cpp

Needs cldr-json/cldr-numbers-full/main and cldr-json/cldr-core/supplemental.
"""
import json, os, sys

root = os.path.join(sys.argv[1], "cldr-json")
version = json.load(open(os.path.join(root, "cldr-core/package.json")))["version"]
systems = json.load(open(os.path.join(root, "cldr-core/supplemental/numberingSystems.json")))["supplemental"]["numberingSystems"]
main = os.path.join(root, "cldr-numbers-full/main")
rows = []
for loc in sorted(os.listdir(main)):
    numbers = json.load(open(os.path.join(main, loc, "numbers.json")))["main"][loc]["numbers"]
    ns = numbers.get("defaultNumberingSystem", "latn")
    if ns == "latn":
        continue
    zero = systems[ns]["_digits"][0]
    rows.append((loc, ns, ord(zero)))

print(f"// Generated by tools/gen-locale-digits from CLDR {version} (defaultNumberingSystem). Do not edit.")
print()
print('#include "kiln/text/LocaleFormat.h"')
print()
print("#include <string>")
print()
print("namespace kiln::text {")
print()
print("    namespace {")
print("        struct DigitsEntry { const char* tag; char32_t zero; };")
print("        // Locales whose default digits are not 0-9 (every other locale uses 0-9).")
print("        constexpr DigitsEntry kDigits[] = {")
for loc, ns, z in rows:
    print(f'            {{ "{loc}", U\'\\x{z:X}\' }},   // {ns}')
print("        };")
print("    }")
print()
print("    char32_t LocaleZeroDigit(std::string_view tag) {")
print("        // CLDR inheritance: drop subtags from the end until a locale has an entry.")
print("        std::string t(tag);")
print("        while (true) {")
print("            for (const DigitsEntry& e : kDigits) if (t == e.tag) return e.zero;")
print("            const auto dash = t.rfind('-');")
print("            if (dash == std::string::npos) return U'0';")
print("            t.resize(dash);")
print("        }")
print("    }")
print()
print("}")
