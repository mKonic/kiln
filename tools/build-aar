#!/usr/bin/env bash
# build-aar [--out build/kiln.aar] [abi...]: kiln as an Android library for Gradle users.
#
# The AAR holds the Java host (classes.jar), a manifest declaring KilnActivity, and a Prefab
# package "kiln" with the C / C++ headers and one static libkiln.a per ABI (64-bit only). An
# app is one shared library linking libkiln.a whole (its JNI natives are only reached from
# Java) and exporting kiln_main; KilnActivity loads it by the "dev.kiln.lib_name" meta-data.
# samples/gradle-notes shows the Gradle and CMake side.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/android-env.sh"
OUT="$KILN_ROOT/build/kiln.aar"
ABIS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --out) OUT="$2"; shift 2 ;;
        *) ABIS+=("$1"); shift ;;
    esac
done
[ ${#ABIS[@]} -gt 0 ] || ABIS=(arm64-v8a x86_64)
# Prefab wants numbers: the tag's (v1.2.3 -> 1.2.3), 0.0.0 before the first tag.
VERSION="$("$KILN_ROOT/scripts/version.sh" name | sed -nE 's/^v([0-9]+\.[0-9]+\.[0-9]+).*/\1/p')"
VERSION="${VERSION:-0.0.0}"
NDK_MAJOR="$(sed -n 's/^Pkg.Revision *= *\([0-9]*\).*/\1/p' "$NDK/source.properties")"
# What a C app links, besides the platform libraries (the C ABI glue is in kiln_material3).
ARCHIVES=(kiln_android kiln_material3 kiln_foundation kiln_core mcu hearth hearth_vulkan_deps clipper2 skia_shadow)

STAGING="$KILN_ROOT/build/aar"
rm -rf "$STAGING"; mkdir -p "$STAGING/classes" "$STAGING/prefab/modules/kiln/include"

# Native: build, then merge the archives into one libkiln.a per ABI.
"$KILN_ROOT/tools/build-android.sh" "${ABIS[@]}" >/dev/null
for abi in "${ABIS[@]}"; do
    dir="$KILN_ROOT/build/android/$abi"
    libdir="$STAGING/prefab/modules/kiln/libs/android.$abi"
    mkdir -p "$libdir"
    {
        echo "CREATE $libdir/libkiln.a"
        for a in "${ARCHIVES[@]}"; do echo "ADDLIB $dir/lib$a.a"; done
        echo "SAVE"; echo "END"
    } | "$NDK_TOOLCHAIN/bin/llvm-ar" -M
    "$NDK_TOOLCHAIN/bin/llvm-strip" --strip-debug "$libdir/libkiln.a"
    cat > "$libdir/abi.json" <<JSON
{ "abi": "$abi", "api": $ANDROID_MIN_SDK, "ndk": $NDK_MAJOR, "stl": "c++_static", "static": true }
JSON
    # Volition's commands, for debug builds (linked whole next to libkiln.a).
    vdir="$STAGING/prefab/modules/kiln_volition/libs/android.$abi"
    mkdir -p "$vdir"
    cmake --build "$dir" --target kiln_volition >/dev/null
    "$NDK_TOOLCHAIN/bin/llvm-strip" --strip-debug "$dir/libkiln_volition.a" -o "$vdir/libkiln_volition.a"
    cp "$libdir/abi.json" "$vdir/abi.json"
    # SQLite (vendor/sqlite), for apps that keep a database.
    sdir="$STAGING/prefab/modules/kiln_sqlite3/libs/android.$abi"
    mkdir -p "$sdir"
    cmake --build "$dir" --target kiln_sqlite3 >/dev/null
    "$NDK_TOOLCHAIN/bin/llvm-strip" --strip-debug "$dir/libkiln_sqlite3.a" -o "$sdir/libkiln_sqlite3.a"
    cp "$libdir/abi.json" "$sdir/abi.json"
done
mkdir -p "$STAGING/prefab/modules/kiln_sqlite3/include"
cp "$KILN_ROOT/vendor/sqlite/sqlite3.h" "$STAGING/prefab/modules/kiln_sqlite3/include/"
cat > "$STAGING/prefab/modules/kiln_sqlite3/module.json" <<JSON
{ "export_libraries": [], "library_name": "libkiln_sqlite3" }
JSON
mkdir -p "$STAGING/prefab/modules/kiln_volition/include/kiln"
cat > "$STAGING/prefab/modules/kiln_volition/include/kiln/volition.h" <<'H'
/* kiln_volition: link this library whole into a debug build's app library, and declare
 * dev.kiln.KilnVolition as a provider in the debug manifest, to answer Volition's commands.
 * Release builds leave it out. It has no API of its own. */
H
cat > "$STAGING/prefab/modules/kiln_volition/module.json" <<JSON
{ "export_libraries": [":kiln"], "library_name": "libkiln_volition" }
JSON
# The headers of the C ABI and kiln++ (kiln.hpp is the in-tree C++ API's entry: not shipped).
mkdir -p "$STAGING/prefab/modules/kiln/include/kiln"
cp "$KILN_ROOT"/include/kiln/{kiln.h,kiln_m3.h,kilnpp.hpp,kiln_m3.hpp} "$STAGING/prefab/modules/kiln/include/kiln/"
# The version script an app's library links with: it exports JNI_OnLoad alone, so the linker
# drops the kiln code the app never reaches (samples/gradle-notes shows the link options).
cp "$KILN_ROOT/platform/android/app.map" "$STAGING/prefab/modules/kiln/include/kiln/"
cat > "$STAGING/prefab/prefab.json" <<JSON
{ "schema_version": 2, "name": "kiln", "version": "$VERSION", "dependencies": [] }
JSON
# Platform libraries libkiln.a needs, and libc++ (static) so a C app links without a C++ driver.
cat > "$STAGING/prefab/modules/kiln/module.json" <<JSON
{ "export_libraries": ["-landroid", "-ljnigraphics", "-lnativewindow", "-lmediandk", "-llog", "-lvulkan", "-lc++_static", "-lc++abi", "-lm"], "library_name": "libkiln" }
JSON

# Java host.
mapfile -t SOURCES < <(find "$KILN_ROOT/platform/android/java" -name '*.java')
# androidx interfaces kiln implements when the app has them: compiled against, not packaged.
mapfile -t STUBS < <(find "$KILN_ROOT/platform/android/java-stubs" -name '*.java')
mkdir -p "$STAGING/stubs"
javac --release 17 -nowarn -classpath "$ANDROID_JAR" -d "$STAGING/stubs" "${STUBS[@]}"
javac --release 17 -nowarn -classpath "$ANDROID_JAR:$STAGING/stubs" -d "$STAGING/classes" "${SOURCES[@]}"
(cd "$STAGING/classes" && jar --create --file "$STAGING/classes.jar" .)

cat > "$STAGING/AndroidManifest.xml" <<XML
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.kiln">
    <uses-sdk android:minSdkVersion="$ANDROID_MIN_SDK" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="true" />
    <!-- The text toolbar's PROCESS_TEXT activities and Look Up. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.LOOK_UP_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
    <application android:enableOnBackInvokedCallback="true">
        <!-- The OEM window extensions (folds and hinges), where the device has them. -->
        <uses-library android:name="androidx.window.extensions" android:required="false" />
        <uses-library android:name="androidx.window.sidecar" android:required="false" />
        <!-- Apps add the dev.kiln.lib_name meta-data and their launcher intent filter. -->
        <activity android:name="dev.kiln.KilnActivity"
                  android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
                  android:windowSoftInputMode="adjustResize"
                  android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|navigation|locale|layoutDirection|colorMode|touchscreen|grammaticalGender" />
        <!-- kiln::work's jobs (JobScheduler). -->
        <service android:name="dev.kiln.KilnJobService" android:exported="false"
                 android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- kiln::media's sessions: playback in a media foreground service (the app declares
             FOREGROUND_SERVICE and FOREGROUND_SERVICE_MEDIA_PLAYBACK to use it). -->
        <service android:name="dev.kiln.KilnMediaService" android:exported="false"
                 android:foregroundServiceType="mediaPlayback" />
        <!-- ui::GetUriForFile: the app's files, shared by content:// URI (FileProvider). -->
        <provider android:name="dev.kiln.KilnFileProvider" android:authorities="${applicationId}.kiln.fileprovider"
                  android:exported="false" android:grantUriPermissions="true" />
        <!-- kiln::alarm: alarms going off, and set again after a reboot (with the app's
             RECEIVE_BOOT_COMPLETED) or when exact alarms are allowed again. -->
        <receiver android:name="dev.kiln.KilnAlarmReceiver" android:exported="false" />
        <receiver android:name="dev.kiln.KilnAlarmRescheduler" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
XML
# kiln's resources (the widget layouts), raw as an AAR carries them, and their symbols.
rm -rf "$STAGING/res"
cp -r "$KILN_ROOT/platform/android/res" "$STAGING/res"
{
    for f in "$STAGING"/res/layout/*.xml; do echo "int layout $(basename "$f" .xml) 0x0"; done
    grep -ho '@+id/[a-z_]*' "$STAGING"/res/layout/*.xml | sort -u | sed 's|@+id/|int id |; s|$| 0x0|'
} > "$STAGING/R.txt"
# Rules for an app that shrinks its code: native code finds kiln's Java by name, and the androidx
# interfaces kiln's embedded-View holder implements are the app's to bring.
cat > "$STAGING/proguard.txt" <<RULES
-keep class dev.kiln.** { *; }
-dontwarn androidx.core.view.NestedScrollingParent
-dontwarn androidx.core.view.NestedScrollingParent2
-dontwarn androidx.core.view.NestedScrollingParent3
RULES

mkdir -p "$(dirname "$OUT")"
rm -f "$OUT"
(cd "$STAGING" && zip -qr "$OUT" AndroidManifest.xml classes.jar R.txt proguard.txt prefab res)
echo "AAR: $OUT ($(du -h "$OUT" | cut -f1))"
