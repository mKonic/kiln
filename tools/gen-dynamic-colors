#!/usr/bin/env python3
"""Generates the dynamic colour plumbing from material3's styles (DynamicTonalPalette.android.kt
reads them through R.style.mc3_palette / mc3_light_scheme / mc3_dark_scheme).

usage: tools/gen-dynamic-colors <androidx-compose checkout> <kiln checkout>

Writes:
  platform/android/java/dev/kiln/KilnSystemColors.java   reads the android:color/system_* colours
      each style item names, in the styles' order (API 31 palette, API 34 light then dark roles)
  material3/src/kiln/material3/DynamicColorFields.h      the TonalPalette field / ColorScheme role
      at each position, and TonalPalette itself (TonalPalette.kt's fields)
  material3/src/kiln/material3/DynamicColorScheme.cpp    dynamicTonalPalette's synthesised tones,
      the API 31 scheme mappings and the API 34 path
"""
import os, re, sys
import xml.etree.ElementTree as ET

compose, kiln = sys.argv[1], sys.argv[2]
m3 = os.path.join(compose, "compose/material3/material3/src")
res = os.path.join(m3, "androidMain/res")


def style_items(path, style):
    root = ET.parse(path).getroot()
    for st in root.iter("style"):
        if st.get("name") == style:
            return [(it.get("name"), it.text.strip()) for it in st.iter("item")]
    sys.exit(f"gen-dynamic-colors: no style {style} in {path}")


def camel(attr, prefix):
    parts = attr[len(prefix):].split("_")
    return parts[0] + "".join(p.capitalize() for p in parts[1:])


palette = style_items(os.path.join(res, "values-v31/styles.xml"), "mc3_palette")
light = style_items(os.path.join(res, "values-v34/styles.xml"), "mc3_light_scheme")
dark = style_items(os.path.join(res, "values-v34/styles.xml"), "mc3_dark_scheme")
if [n for n, _ in light] != [n for n, _ in dark]:
    sys.exit("gen-dynamic-colors: light and dark schemes list different attributes")

tonal_fields = re.findall(r"val (\w+): Color", open(os.path.join(m3, "commonMain/kotlin/androidx/compose/material3/TonalPalette.kt")).read())
palette_fields = [camel(n, "mc3_") for n, _ in palette]
for f in palette_fields:
    if f not in tonal_fields:
        sys.exit(f"gen-dynamic-colors: {f} is not a TonalPalette field")
role_fields = [camel(n, "mc3_") for n, _ in light]


def color_name(ref):
    if not ref.startswith("@android:color/"):
        sys.exit(f"gen-dynamic-colors: unexpected colour reference {ref}")
    return ref[len("@android:color/"):]


java = [
    "package dev.kiln;",
    "",
    "import android.content.Context;",
    "import android.os.Build;",
    "",
    "/**",
    " * Generated by tools/gen-dynamic-colors from material3's mc3 styles. Do not edit. The platform's",
    " * Material You colours in the order the styles list them: the API 31 palette, and the API 34",
    " * light then dark scheme roles. Empty arrays where the API level lacks them.",
    " */",
    "final class KilnSystemColors {",
    "    private KilnSystemColors() {}",
    "",
    "    static int[] palette(Context c) {",
    "        if (Build.VERSION.SDK_INT < 31) return new int[0];",
    "        return new int[] {",
]
java += [f"            c.getColor(android.R.color.{color_name(ref)})," for _, ref in palette]
java += ["        };", "    }", "",
         "    static int[] roles(Context c) {",
         "        if (Build.VERSION.SDK_INT < 34) return new int[0];",
         "        return new int[] {"]
java += [f"            c.getColor(android.R.color.{color_name(ref)})," for _, ref in light]
java += [f"            c.getColor(android.R.color.{color_name(ref)})," for _, ref in dark]
java += ["        };", "    }", "}", ""]
open(os.path.join(kiln, "platform/android/java/dev/kiln/KilnSystemColors.java"), "w").write("\n".join(java))

h = ["#pragma once", "",
     "// Generated by tools/gen-dynamic-colors from material3's mc3 styles and TonalPalette.kt. Do not edit.", "",
     '#include "kiln/Internal.h"',
     '#include "kiln/material3/ColorScheme.h"',
     '#include "kiln/material3/tokens/PaletteTokens.h"', "",
     "namespace kiln::material3 {", "",
     "    // TonalPalette (TonalPalette.kt): the tones dynamic colour schemes are built from.",
     "    struct TonalPalette {"]
h += [f"        Color {f};" for f in tonal_fields]
h += ["        bool operator==(const TonalPalette&) const = default;", "    };", "",
      f"    KILN_INTERNAL inline constexpr int kSystemPaletteCount = {len(palette_fields)};",
      "    // The TonalPalette field each value of the platform palette (KilnSystemColors.palette) fills.",
      "    KILN_INTERNAL inline constexpr Color TonalPalette::* kSystemPaletteFields[kSystemPaletteCount] = {"]
h += [f"        &TonalPalette::{f}," for f in palette_fields]
h += ["    };", "",
      f"    KILN_INTERNAL inline constexpr int kSystemRoleCount = {len(role_fields)};",
      "    // The ColorScheme role of each platform scheme value (KilnSystemColors.roles: light, then",
      "    // dark, each in this order).",
      "    KILN_INTERNAL inline constexpr Color ColorScheme::* kSystemRoleFields[kSystemRoleCount] = {"]
h += [f"        &ColorScheme::{f}," for f in role_fields]
# BaselineTonalPalette: each field from PaletteTokens.
tp = open(os.path.join(m3, "commonMain/kotlin/androidx/compose/material3/TonalPalette.kt")).read()
base = re.search(r"internal val BaselineTonalPalette =\s*TonalPalette\((.*?)\n    \)", tp, re.S).group(1)
pairs = re.findall(r"(\w+) = (?:PaletteTokens\.(\w+)|Color\.Unspecified),", base)
if sorted(f for f, _ in pairs) != sorted(tonal_fields):
    sys.exit("gen-dynamic-colors: BaselineTonalPalette does not set every field once")
h += ["    };", "",
      "    // BaselineTonalPalette: the baseline palette tokens as a TonalPalette.",
      "    inline TonalPalette BaselineTonalPalette() {",
      "        TonalPalette p;"]
h += [f"        p.{f} = tokens::PaletteTokens::{t};" if t else f"        p.{f} = Color::Unspecified();" for f, t in pairs]
h += ["        return p;", "    }", "", "}", ""]
open(os.path.join(kiln, "material3/src/kiln/material3/DynamicColorFields.h"), "w").write("\n".join(h))
print(f"gen-dynamic-colors: {len(palette_fields)} palette tones, {len(role_fields)} roles", file=sys.stderr)

# --- DynamicColorScheme.cpp from DynamicTonalPalette.android.kt ---------------------------------
kt = open(os.path.join(m3, "androidMain/kotlin/androidx/compose/material3/DynamicTonalPalette.android.kt")).read()
pal = " ".join(re.search(r"internal fun dynamicTonalPalette\(context: Context\): TonalPalette \{(.*?)\n\}", kt, re.S).group(1).split())
direct = re.findall(r"(\w+) = typedArray\.getColor\(R\.styleable\.mc3_palette_mc3_(\w+)\),", pal)
lum = [(a, b, c) for a, b, c in re.findall(r"(\w+) = typedArray ?\.getColor\(R\.styleable\.mc3_palette_mc3_(\w+)\) ?\.setLuminance\(([\d.]+)f\)", pal)]
for f, a in direct:
    if f != camel("mc3_" + a, "mc3_"):
        sys.exit(f"gen-dynamic-colors: palette field {f} reads {a}")
if len(direct) + len(lum) != len(tonal_fields):
    sys.exit("gen-dynamic-colors: dynamicTonalPalette sets fields this script does not read")


def mapping(fn):
    body = re.search(r"internal fun %s\(tonalPalette: TonalPalette\) =\s*\w+ColorScheme\((.*?)\n    \)" % fn, kt, re.S).group(1)
    return re.findall(r"(\w+) = tonalPalette\.(\w+),", body)


code = ["// Generated by tools/gen-dynamic-colors from material3's DynamicTonalPalette.android.kt. Do not edit.", "",
        '#include "kiln/material3/DynamicColorScheme.h"', "",
        '#include "kiln/material3/internal/colorUtil/ColorUtil.h"', "",
        "namespace kiln::material3 {", "",
        "    namespace {",
        "        int PaletteIndex(Color TonalPalette::* field) {",
        "            for (int i = 0; i < kSystemPaletteCount; ++i) if (kSystemPaletteFields[i] == field) return i;",
        "            return -1;",
        "        }",
        "        Color Lum(const std::vector<std::uint32_t>& palette, Color TonalPalette::* from, float lstar) {",
        "            return Color(colorutil::SetLuminance(palette[std::size_t(PaletteIndex(from))], lstar));",
        "        }",
        "    }", "",
        "    std::optional<TonalPalette> DynamicTonalPalette(const ui::Configuration& config) {",
        "        const auto& palette = config.systemPalette;",
        "        if (int(palette.size()) != kSystemPaletteCount) return std::nullopt;",
        "        TonalPalette p;",
        "        for (int i = 0; i < kSystemPaletteCount; ++i) p.*kSystemPaletteFields[i] = Color(palette[std::size_t(i)]);",
        "        // Tones the platform palette lacks: another tone at the given L* (setLuminance)."]
for f, a, l in lum:
    code.append(f"        p.{f} = Lum(palette, &TonalPalette::{camel('mc3_' + a, 'mc3_')}, {l if '.' in l else l + '.0'}f);")
code += ["        return p;", "    }", ""]
for name, fn, base in (("DynamicLightColorScheme31", "dynamicLightColorScheme31", "LightColorScheme"),
                       ("DynamicDarkColorScheme31", "dynamicDarkColorScheme31", "DarkColorScheme")):
    code += [f"    ColorScheme {name}(const TonalPalette& t) {{", f"        return {base}([&t](ColorScheme& s) {{"]
    code += [f"            s.{r} = t.{f};" for r, f in mapping(fn)]
    code += ["        });", "    }", ""]
code += """    namespace {
        // dynamic*ColorScheme34: the scheme's roles from the platform (light or dark half); the
        // rest (error roles, scrim) keep the baseline scheme's.
        ColorScheme Scheme34(ColorScheme s, const std::vector<std::uint32_t>& roles, int half) {
            for (int i = 0; i < kSystemRoleCount; ++i) s.*kSystemRoleFields[i] = Color(roles[std::size_t(half * kSystemRoleCount + i)]);
            return s;
        }
    }

    std::optional<ColorScheme> DynamicLightColorScheme(const ui::Configuration& config) {
        if (int(config.systemRoles.size()) == 2 * kSystemRoleCount) return Scheme34(LightColorScheme(), config.systemRoles, 0);
        if (auto palette = DynamicTonalPalette(config)) return DynamicLightColorScheme31(*palette);
        return std::nullopt;
    }

    std::optional<ColorScheme> DynamicDarkColorScheme(const ui::Configuration& config) {
        if (int(config.systemRoles.size()) == 2 * kSystemRoleCount) return Scheme34(DarkColorScheme(), config.systemRoles, 1);
        if (auto palette = DynamicTonalPalette(config)) return DynamicDarkColorScheme31(*palette);
        return std::nullopt;
    }

    std::optional<ColorScheme> DynamicLightColorScheme() {
        return DynamicLightColorScheme(rt::Composition::Current()->Read(ui::LocalConfiguration));
    }

    std::optional<ColorScheme> DynamicDarkColorScheme() {
        return DynamicDarkColorScheme(rt::Composition::Current()->Read(ui::LocalConfiguration));
    }

}
""".split("\n")
open(os.path.join(kiln, "material3/src/kiln/material3/DynamicColorScheme.cpp"), "w").write("\n".join(code))
