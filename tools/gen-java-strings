#!/usr/bin/env python3
"""Generates a table of an androidx library's translated strings for kiln's Java host.

usage: tools/gen-java-strings <androidx-compose checkout> <res dir in it> <Class> FIELD=string_name...

Writes platform/android/java/dev/kiln/<Class>.java: for each FIELD, the string's value per locale
tag ("" the default), and pick(), which chooses the value for the launcher's or app's locales.
kiln keeps these out of its res/ (values-<language> folders would read as the app's own
languages in kiln-pack).

  tools/gen-java-strings ~/androidx glance/glance-appwidget/src/main/res KilnGlanceStrings ERROR_TEXT=glance_error_layout_text_v2
  tools/gen-java-strings ~/androidx biometric/biometric/src/main/res KilnBiometricStrings \\
      DEFAULT_ERROR=default_error_msg USER_CANCELED=generic_error_user_canceled MORE_OPTIONS=content_view_more_options_button_clicked
"""
import os, subprocess, sys, tempfile
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from android_res import read_tables

checkout, res, cls = sys.argv[1], sys.argv[2], sys.argv[3]
fields = [a.split("=", 1) for a in sys.argv[4:]]
root = os.path.join(checkout, res)
if not os.path.isdir(root):
    # A sparse checkout: read the resources from git.
    tmp = tempfile.mkdtemp()
    files = subprocess.run(["git", "-C", checkout, "ls-tree", "-r", "--name-only", "HEAD", res], capture_output=True, text=True, check=True).stdout.split()
    for f in files:
        if not f.endswith("strings.xml"):
            continue
        dst = os.path.join(tmp, os.path.relpath(f, res))
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        with open(dst, "wb") as out:
            out.write(subprocess.run(["git", "-C", checkout, "show", "HEAD:" + f], capture_output=True, check=True).stdout)
    root = tmp
tables = read_tables(root)
for field, key in fields:
    if tables.get("", {}).get(key) is None:
        sys.exit(f"gen-java-strings: no default value for {key}")

def jstr(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'

out = [f"// Generated by tools/gen-java-strings from {res}/values*/strings.xml. Do not edit.",
       "package dev.kiln;", "",
       "import android.os.LocaleList;", "",
       "import java.util.HashMap;", "import java.util.Locale;", "import java.util.Map;", "",
       f"/** {', '.join(k for _, k in fields)} per locale tag (\"\" the default). */",
       f"final class {cls} {{"]
for field, key in fields:
    out.append(f"    static final Map<String, String> {field} = new HashMap<>();")
out.append("    static {")
count = 0
for field, key in fields:
    for tag in sorted(tables):
        v = tables[tag].get(key)
        if v is None:
            continue
        out.append(f"        {field}.put({jstr(tag)}, {jstr(v)});")
        count += 1
out += ["    }", "",
        "    /** The value for the first locale that has one (its tag, then without region or script), else the default. */",
        "    static String pick(Map<String, String> values, LocaleList locales) {",
        "        for (int i = 0; i < locales.size(); i++) {",
        "            Locale l = locales.get(i);",
        "            String v = values.get(l.toLanguageTag());",
        "            if (v == null && !l.getScript().isEmpty()) v = values.get(l.getLanguage() + \"-\" + l.getScript());",
        "            if (v == null && !l.getCountry().isEmpty()) v = values.get(l.getLanguage() + \"-\" + l.getCountry());",
        "            if (v == null) v = values.get(l.getLanguage());",
        "            if (v != null) return v;",
        "            if (l.getLanguage().equals(\"en\")) break;",
        "        }",
        "        return values.get(\"\");",
        "    }", "",
        f"    private {cls}() {{}}", "}"]
dst = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "platform/android/java/dev/kiln", cls + ".java")
open(dst, "w").write("\n".join(out) + "\n")
print(f"gen-java-strings: {cls}, {count} values", file=sys.stderr)
