#!/usr/bin/env python3
"""Generates the material3 C ABI from the material3 headers with libclang.

Writes include/kiln/kiln_m3.h, material3/src/kiln/capi/M3CApi.gen.cpp (the glue) and
material3/src/kiln/capi/M3CApi.skipped.txt (what could not be mapped, and why).

  tools/gen-capi [--build build/host]

Mapping (design/capi.md):
- Functions become kiln_m3_<namespace>_<name>(kiln_key key, ...). Each runs in its own keyed group
  inside content (directly outside it). Parameters the C side cannot express are left out when
  they have a default; otherwise the function is skipped.
- material3 structs with public fields become C structs starting with `size_t size`, with
  kiln_m3_<name>_init(). They pass by pointer (NULL: the default) and come back through an `out`
  pointer whose size the caller set, so they can grow.
- Classes (states, scopes) become opaque handles with their public methods. A function that
  returns one (rememberX) remembers the handle at its call; suspending methods take a `done`
  callback.
- kiln::Function parameters become callback structs { call, user, drop }.
- Enums become C enums.
"""

import argparse
import glob
import json
import os
import re
import shlex
import subprocess
import sys
from dataclasses import dataclass, field

import clang.cindex as ci

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CORE_NAMES = set(re.findall(r'\bkiln_\w+', open(os.path.join(ROOT, 'include/kiln/kiln.h')).read()))
M3_DIR = os.path.join(ROOT, 'material3/src/kiln/material3')
SKIP_NAMESPACES = {'internal', 'detail', 'tokens', 'impl'}


def snake(name):
    s = re.sub(r'([A-Z]+)([A-Z][a-z])', r'\1_\2', name)
    s = re.sub(r'([a-z0-9])([A-Z])', r'\1_\2', s)
    return s.lower()


def qualname(cursor):
    parts = []
    c = cursor
    while c is not None and c.kind != ci.CursorKind.TRANSLATION_UNIT:
        if c.spelling:
            parts.append(c.spelling)
        c = c.semantic_parent
    return '::'.join(reversed(parts))


RUST_RESERVED = {'as', 'break', 'const', 'continue', 'crate', 'else', 'enum', 'extern', 'false', 'fn', 'for', 'if', 'impl', 'in',
                 'let', 'loop', 'match', 'mod', 'move', 'mut', 'pub', 'ref', 'return', 'self', 'Self', 'static', 'struct', 'super',
                 'trait', 'true', 'type', 'unsafe', 'use', 'where', 'while', 'async', 'await', 'dyn', 'abstract', 'become', 'box',
                 'do', 'final', 'macro', 'override', 'priv', 'typeof', 'unsized', 'virtual', 'yield', 'try', 'gen'}

CPP_RESERVED = {'switch', 'default', 'delete', 'new', 'class', 'template', 'operator', 'private', 'public', 'protected', 'this',
                'throw', 'try', 'catch', 'virtual', 'namespace', 'using', 'typename', 'friend', 'explicit', 'export', 'and', 'or',
                'not', 'xor', 'bool', 'int', 'float', 'double', 'char', 'short', 'long', 'unsigned', 'signed', 'void', 'auto',
                'const', 'static', 'struct', 'union', 'enum', 'return', 'if', 'else', 'for', 'while', 'do', 'break', 'continue',
                'goto', 'case', 'register', 'extern', 'inline', 'volatile', 'sizeof', 'typedef', 'true', 'false', 'concept',
                'requires', 'module', 'import', 'key'}

C_RESERVED = {'auto', 'break', 'case', 'char', 'const', 'continue', 'default', 'do', 'double', 'else', 'enum', 'extern', 'float',
              'for', 'goto', 'if', 'int', 'long', 'register', 'return', 'short', 'signed', 'sizeof', 'static', 'struct', 'switch',
              'typedef', 'union', 'unsigned', 'void', 'volatile', 'while', 'bool', 'true', 'false', 'inline', 'restrict',
              # names the glue uses
              'key', 'self', 'out', 'done', 'r', 'h', 'c', 'cp', 'scope', 'out_handle', 'obj'}


VAR_IDS = __import__('itertools').count()


def field_name(n):
    f = snake(n)
    return f + '_value' if f == 'size' else f


def has_default(param):
    toks = [t.spelling for t in param.get_tokens()]
    return '=' in toks


def strip_ref(t):
    if t.kind in (ci.TypeKind.LVALUEREFERENCE, ci.TypeKind.RVALUEREFERENCE):
        return t.get_pointee(), True
    return t, False


def canon(t):
    """Canonical spelling without const."""
    s = t.get_canonical().spelling
    return re.sub(r'^const ', '', s)


def template_args(t):
    t = t.get_canonical()
    return [t.get_template_argument_type(i) for i in range(max(t.get_num_template_arguments(), 0))]



def is_internal(c):
    """KILN_INTERNAL (kiln/Internal.h): public for kiln's own components, internal in Compose."""
    return any(ch.kind == ci.CursorKind.ANNOTATE_ATTR and ch.spelling == 'kiln_internal' for ch in c.get_children())

class Unmappable(Exception):
    pass


@dataclass
class Mapping:
    c: str                      # C type of a parameter or field
    to_cpp: object              # (expr) -> C++ expression
    from_cpp: object = None     # (cpp_expr, out_lines) -> C expression; None: cannot return
    by_out: bool = False        # a struct: returned through an out pointer
    struct: object = None       # the Struct for by_out
    list_item: object = None    # a struct field holding a list: items pointer + count
    list_optional: bool = False # the list is a std::optional: NULL items leave it unset


@dataclass
class Struct:
    qual: str
    c: str
    cursor: object
    fields: list = field(default_factory=list)     # (name, Mapping, cpp_type_spelling)
    omitted: list = field(default_factory=list)


@dataclass
class HandleClass:
    qual: str
    c: str
    cursor: object


@dataclass
class EnumDecl:
    qual: str
    c: str
    values: list


@dataclass
class Callback:
    c: str
    args: list      # (Mapping, cpp type spelling)
    ret: object     # Mapping or None for void
    ret_cpp: str
    cpp_sig: str


class Generator:
    def __init__(self, tu):
        self.tu = tu
        self.structs = {}       # qual -> Struct
        self.handles = {}       # qual -> HandleClass
        self.enums = {}         # qual -> EnumDecl
        self.callbacks = {}     # cpp canonical sig -> Callback
        self.records = {}       # qual -> cursor (material3 records)
        self.handle_quals = set()
        self.skipped = []
        self.header_funcs = []
        self.glue_funcs = []
        self.names = set()
        self.struct_order = []
        self.opt_structs = {}   # C name -> pointer type of its value
        self.opaques = {}       # C name -> C++ type (opaque shared handles)
        self.base_sig = {}      # C name -> (param, C type) of its first overload
        self.returned_callbacks = set()
        self.optional_strings = {}   # C function -> its string parameters that may be NULL

    # --- discovery ---------------------------------------------------------------------------

    def in_m3(self, cursor):
        f = cursor.location.file
        return f is not None and os.path.dirname(os.path.abspath(f.name)) == M3_DIR

    def collect(self):
        def walk(c, ns):
            for ch in c.get_children():
                if ch.kind == ci.CursorKind.NAMESPACE:
                    walk(ch, ns + [ch.spelling])
                elif ch.kind in (ci.CursorKind.STRUCT_DECL, ci.CursorKind.CLASS_DECL) and ch.is_definition():
                    q = qualname(ch)
                    if q.startswith('kiln::material3::'):
                        self.records[q] = ch
                        walk(ch, ns + [ch.spelling])
        walk(self.tu.cursor, [])
        # Records used through shared_ptr or a mutable reference are handles.
        def scan_types(c):
            for ch in c.walk_preorder():
                if ch.kind in (ci.CursorKind.PARM_DECL, ci.CursorKind.FIELD_DECL):
                    t = ch.type
                    if t.kind == ci.TypeKind.LVALUEREFERENCE and not t.get_pointee().is_const_qualified():
                        d = t.get_pointee().get_canonical().get_declaration()
                        if d.kind != ci.CursorKind.NO_DECL_FOUND:
                            self.handle_quals.add(qualname(d))
                    s = canon(strip_ref(t)[0])
                    m = re.match(r'std::shared_ptr<(?:const )?(kiln::material3::[\w:]+)>$', s)
                    if m:
                        self.handle_quals.add(m.group(1))
        scan_types(self.tu.cursor)
        # A record with public fields only, copyable, is a value struct wherever it appears;
        # anything else (private state, methods over it) is a handle.
        for q, cur in self.records.items():
            if not self.public_fields(cur) or self.non_copyable(cur) or self.private_fields(cur):
                self.handle_quals.add(q)
            else:
                self.handle_quals.discard(q)

    def public_fields(self, cur):
        out = []
        default_public = cur.kind == ci.CursorKind.STRUCT_DECL
        for ch in cur.get_children():
            if ch.kind == ci.CursorKind.FIELD_DECL:
                acc = ch.access_specifier
                if acc == ci.AccessSpecifier.PUBLIC or (acc == ci.AccessSpecifier.INVALID and default_public):
                    out.append(ch)
        return out

    def private_fields(self, cur):
        default_public = cur.kind == ci.CursorKind.STRUCT_DECL
        for ch in cur.get_children():
            if ch.kind == ci.CursorKind.FIELD_DECL:
                acc = ch.access_specifier
                if acc in (ci.AccessSpecifier.PRIVATE, ci.AccessSpecifier.PROTECTED) or (acc == ci.AccessSpecifier.INVALID and not default_public):
                    return True
        return False

    def non_copyable(self, cur):
        for ch in cur.get_children():
            if ch.kind == ci.CursorKind.CONSTRUCTOR and ch.is_copy_constructor():
                if 'delete' in [t.spelling for t in ch.get_tokens()]:
                    return True
        return False

    def default_constructible(self, cur):
        ctors = [ch for ch in cur.get_children() if ch.kind == ci.CursorKind.CONSTRUCTOR]
        if not ctors:
            return True
        for ch in ctors:
            if ch.is_default_constructor():
                return 'delete' not in [t.spelling for t in ch.get_tokens()]
            args = list(ch.get_arguments())
            if args and all(has_default(a) for a in args):
                return True
        return False

    # --- names -------------------------------------------------------------------------------

    def c_name_for(self, qual, prefix='kiln_m3_'):
        parts = qual.split('::')
        if parts[:2] == ['kiln', 'material3']:
            parts = parts[2:]
            return prefix + '_'.join(snake(p) for p in parts)
        # Other modules' types: kiln_<name>, or with the namespace where kiln.h has that name.
        plain = 'kiln_' + snake(parts[-1])
        if plain not in CORE_NAMES:
            return plain
        return 'kiln_' + '_'.join(snake(p) for p in parts[1:])

    # --- types -------------------------------------------------------------------------------

    def enum(self, t):
        d = t.get_canonical().get_declaration()
        q = qualname(d)
        if q == 'kiln::text::TextOverflow':
            return Mapping('kiln_text_overflow', lambda e: f'kiln::text::TextOverflow({e})', lambda e, o: f'kiln_text_overflow({e})')
        if q == 'kiln::text::TextAlign':
            return Mapping('kiln_text_align', lambda e: f'kiln::text::TextAlign({e})', lambda e, o: f'kiln_text_align({e})')
        if any(p in SKIP_NAMESPACES for p in q.split('::')):
            raise Unmappable(f'enum {q} is internal')
        if q not in self.enums:
            c = self.c_name_for(q)
            values = [(ch.spelling, ch.enum_value) for ch in d.get_children() if ch.kind == ci.CursorKind.ENUM_CONSTANT_DECL]
            self.enums[q] = EnumDecl(q, c, values)
        c = self.enums[q].c
        return Mapping(c, lambda e, q=q: f'{q}({e})', lambda e, o, c=c: f'{c}({e})')

    def struct(self, q):
        if q in self.structs:
            return self.structs[q]
        cur = self.records[q]
        if not self.default_constructible(cur):
            raise Unmappable(f'{q} is not default-constructible')
        s = Struct(q, self.c_name_for(q), cur)
        self.structs[q] = s     # before the fields: they may refer back
        for f in self.public_fields(cur):
            try:
                m = self.map(f.type, f.spelling, field_=True)
                s.fields.append((f.spelling, m, f.type.spelling))
            except Unmappable as e:
                s.omitted.append((f.spelling, str(e)))
        self.struct_order.append(q)
        return s

    def handle(self, q):
        if any(p in SKIP_NAMESPACES for p in q.split('::')):
            raise Unmappable(f'{q} is internal')
        if q not in self.handles:
            self.handles[q] = HandleClass(q, self.c_name_for(q), self.records.get(q))
        return self.handles[q]

    def handle_mapping(self, q, kind):
        h = self.handle(q)
        c = h.c
        # from_cpp: a handle for the duration of the callback, on the caller's stack.
        def from_ref(e, out, c=c, kind=kind):
            var = f'h{next(VAR_IDS)}'
            out.append(f'auto* {var} = kiln::capi::NewTransient<{c}>();')
            if kind in ('shared', 'shared_const'):
                out.append(f'{var}->owner = std::const_pointer_cast<{q}>({e}); {var}->ptr = {var}->owner.get();')
            else:
                out.append(f'{var}->ptr = const_cast<{q}*>(&({e}));')
            return var
        if kind in ('shared', 'shared_const'):
            return Mapping(f'{c}*', lambda e: f'({e} ? {e}->Shared() : nullptr)', from_ref)
        return Mapping(f'{c}*', lambda e: f'*{e}->ptr', from_ref)

    def callback(self, fn_type, name=''):
        sig = canon(fn_type)
        core = {
            'kiln::Function<void ()>': 'kiln_fn',
            'kiln::Function<void (bool)>': 'kiln_fn_bool',
            'kiln::Function<void (int)>': 'kiln_fn_int',
            'kiln::Function<void (float)>': 'kiln_fn_float',
            'kiln::Function<void (std::basic_string<char>)>': 'kiln_fn_str',
            'kiln::Function<void (const std::basic_string<char> &)>': 'kiln_fn_str',
        }
        if sig in core:
            return Mapping(core[sig], lambda e: f'kiln::capi::Fn({e})', None)
        if sig not in self.callbacks:
            proto = template_args(fn_type)[0]
            ret = proto.get_result()
            args = []
            names = []
            for a in proto.argument_types():
                base, _ = strip_ref(a)
                m = self.map(a, '', arg_of_callback=True)
                if m.from_cpp is None:
                    raise Unmappable(f'callback argument {a.spelling}')
                if m.by_out and a.kind == ci.TypeKind.LVALUEREFERENCE and not a.get_pointee().is_const_qualified():
                    # A struct the callback edits in place: a pointer it writes, copied back after.
                    st = m.struct
                    def from_mut(e, o, st=st):
                        var = f't{next(VAR_IDS)}'
                        o.append(f'auto* {var} = kiln::capi::NewTransient<{st.c}>(); {var}->size = sizeof(*{var}); FromCpp({e}, {var});')
                        o.append(f'@post {e} = ToCpp({var});')
                        return var
                    m = Mapping(f'{st.c}*', m.to_cpp, from_mut, by_out=False, struct=st)
                args.append((m, a.spelling))
                names.append('fn' if m.c == 'kiln_fn' else self.type_word(base))
            retm = None
            ret_struct = None
            if ret.kind != ci.TypeKind.VOID:
                retm = self.map(ret, '')
                names.append('to_' + self.type_word(ret))
                if retm.by_out:
                    # A struct result: the callback writes it through a last `out` argument.
                    ret_struct, retm = retm.struct, None
            c = 'kiln_m3_fn_' + ('_'.join(names) if names else 'void')
            self.callbacks[sig] = Callback(c, args, retm, ret.spelling, sig)
            self.callbacks[sig].ret_struct = ret_struct
        cb = self.callbacks[sig]
        # Returned (a C++ default to call or pass back): a callback struct kiln made.
        convertible = getattr(cb, 'ret_struct', None) is None and all(m.to_cpp for m, _ in cb.args) and (cb.ret is None or cb.ret.from_cpp is not None) \
            and not any(m.by_out or m.c.endswith('*') for m, _ in cb.args)
        if convertible:
            self.returned_callbacks.add(cb.c)
        return Mapping(cb.c, lambda e, cb=cb: f'ToCpp_{cb.c}({e})', (lambda e, o, cb=cb: f'FromCpp_{cb.c}({e})') if convertible else None)

    def result_callback(self, t):
        """The `done` callback of a suspending call with a result: void(result)."""
        key = 'result:' + canon(t)
        if key not in self.callbacks:
            m = self.map(t, '')
            if m.from_cpp is None:
                raise Unmappable(f'result {t.spelling}')
            c = 'kiln_m3_fn_' + self.type_word(t)
            cpp = t.get_canonical().spelling
            self.callbacks[key] = Callback(c, [(m, cpp)], None, 'void', f'kiln::Function<void ({cpp})>')
        return self.callbacks[key]

    def guarded_from(self, im, e):
        """An optional's value converted only when it is there (the conversion may need statements)."""
        lines = []
        expr = im.from_cpp(f'(*({e}))', lines)
        body = ' '.join(lines)
        return f'([&]() -> {im.c} {{ if (!({e})) return nullptr; {body} return {expr}; }}())'

    def opaque(self, q, const):
        core = {'kiln::ui::NestedScrollConnection': 'kiln_nested_scroll_connection'}
        if q in core:   # declared by kiln.h (a modifier takes it)
            c = core[q]
            cpp = f'std::shared_ptr<{"const " if const else ""}{q}>'
            return Mapping(f'{c}*', lambda e, cpp=cpp, q=q: f'({e} ? std::const_pointer_cast<{"const " if const else ""}{q}>(std::static_pointer_cast<const {q}>({e}->p)) : {cpp}{{}})',
                           lambda e, o, c=c: f'kiln::capi::TransientOpaque<{c}>({e})')
        c = 'kiln_' + snake(q.split('::')[-1])
        if c in CORE_NAMES or q.startswith('kiln::material3::'):
            c = self.c_name_for(q).replace('kiln_m3_', 'kiln_m3_') if q.startswith('kiln::material3::') else 'kiln_' + '_'.join(snake(p) for p in q.split('::')[1:])
        self.opaques[c] = q
        cpp = f'std::shared_ptr<{"const " if const else ""}{q}>'
        return Mapping(f'{c}*', lambda e, cpp=cpp, q=q: f'({e} ? std::const_pointer_cast<{"const " if const else ""}{q}>(std::static_pointer_cast<const {q}>({e}->p)) : {cpp}{{}})',
                       lambda e, o, c=c: f'kiln::capi::TransientOpaque<{c}>({e})')

    def nested_optional(self, inner, name):
        """optional<optional<X>>: unset, none, or a value (Compose's default / null / given)."""
        x = template_args(inner)[0]
        xm = self.map(x, name)
        cpp_x = x.get_canonical().spelling
        if xm.by_out:
            ptr = f'const {xm.struct.c}*'
            conv = lambda e: f'ToCpp({e})'
        elif xm.c.endswith('*'):
            ptr = xm.c
            conv = xm.to_cpp
        elif xm.c.startswith('kiln_') and not xm.c.startswith('kiln_fn'):
            ptr = f'const {xm.c}*'
            conv = lambda e, xm=xm: xm.to_cpp(f'(*{e})')
        else:
            raise Unmappable(f'nested optional of {cpp_x}')
        c = 'kiln_m3_opt_' + self.type_word(x)
        self.opt_structs[c] = ptr
        self.names.add(c)
        return Mapping(c, lambda e, conv=conv, cpp=cpp_x: f'({e}.set ? std::optional<std::optional<{cpp}>>({e}.value ? std::optional<{cpp}>({conv(e + ".value")}) : std::nullopt) : std::nullopt)', None)

    def type_word(self, t):
        k = canon(strip_ref(t)[0])
        k = re.sub(r'std::basic_string<char>', 'string', k)
        k = re.sub(r'std::shared_ptr<(const )?(.*)>', r'\2', k)
        k = re.sub(r'std::optional<(.*)>', r'opt_\1', k)
        k = k.split('::')[-1].replace(' ', '_')
        return snake(k)

    def map(self, t, name, field_=False, arg_of_callback=False):
        base, is_ref = strip_ref(t)
        k = canon(base)
        if field_ and k.startswith('std::vector<'):
            item = self.map(template_args(base)[0], name)
            if item.by_out or item.c.startswith('kiln_fn') or item.c.startswith('kiln_m3_fn') or item.c.startswith('kiln_m3_opt'):
                raise Unmappable(f'list of {k}')
            ptr = f'{item.c} const*' if item.c.endswith('*') else f'const {item.c}*'
            return Mapping(ptr, None, None, list_item=item)
        if base.kind == ci.TypeKind.POINTER and canon(base.get_pointee()) == 'kiln::foundation::ScrollState':
            return Mapping('kiln_scroll_state*', lambda e: f'({e} ? {e}->state : nullptr)', None)
        if base.get_canonical().kind == ci.TypeKind.POINTER and base.get_canonical().get_pointee().spelling == 'const char':
            k = 'const char *'   # canon() drops the const; also a constant pointer (const char* const)
        if base.get_canonical().kind == ci.TypeKind.POINTER and k != 'const char *':
            raise Unmappable(f'pointer {t.spelling}')
        scalars = {'bool': 'bool', 'int': 'int32_t', 'float': 'float', 'double': 'double', 'long': 'int64_t',
                   'long long': 'int64_t', 'unsigned int': 'uint32_t', 'unsigned long': 'uint64_t', 'unsigned char': 'uint8_t',
                   'char32_t': 'uint32_t'}   # a code point
        if k in scalars:
            c = scalars[k]
            return Mapping(c, lambda e: f'{e}', lambda e, o: f'{c}({e})')
        if k == 'const char *':
            return Mapping('const char*', lambda e: f'({e} ? {e} : "")', lambda e, o: f'kiln::capi::TransientString({e})')
        if k == 'std::basic_string<char>' or k == 'std::basic_string_view<char>':
            return Mapping('const char*', lambda e: f'kiln::capi::ToString({e})', lambda e, o: f'kiln::capi::TransientString(std::string({e}))')
        if k == 'kiln::ui::Dp':
            return Mapping('float', lambda e: f'kiln::capi::ToDp({e})', lambda e, o: f'({e}).value')
        if k == 'kiln::ui::Color':
            return Mapping('kiln_color', lambda e: f'kiln::capi::ToColor({e})', lambda e, o: f'kiln::capi::FromColor({e})')
        if k == 'kiln::ui::Modifier':
            return Mapping('const kiln_modifier*', lambda e: f'kiln::capi::ToModifier({e})', lambda e, o: f'kiln::capi::NewModifier({e})')
        if k == 'std::shared_ptr<const kiln::gfx::Shape>':
            return Mapping('const kiln_shape*', lambda e: f'kiln::capi::ToShape({e})', lambda e, o: f'kiln::capi::TransientShape({e})')
        if k == 'kiln::text::TextStyle':
            return Mapping('const kiln_text_style*', lambda e: f'({e} ? {e}->style : kiln::text::TextStyle{{}})',
                           lambda e, o: f'kiln::capi::TransientTextStyle({e})')
        if k == 'std::shared_ptr<const kiln::anim::AnimationSpec>':
            return Mapping('const kiln_anim_spec*', lambda e: f'({e} ? {e}->spec : nullptr)', lambda e, o: f'kiln::capi::TransientSpec({e})')
        if k == 'kiln::foundation::PaddingValues':
            return Mapping('kiln_padding', lambda e: f'kiln::capi::ToPadding({e})', lambda e, o: f'kiln::capi::FromPadding({e})')
        if k == 'kiln::ui::Alignment':
            return Mapping('kiln_alignment', lambda e: f'kiln::capi::ToAlignment({e})', lambda e, o: f'kiln_alignment{{ ({e}).horizontal, ({e}).vertical }}')
        if k == 'kiln::ui::AlignmentH':
            return Mapping('float', lambda e: f'kiln::ui::AlignmentH{{ {e} }}', lambda e, o: f'({e}).bias')
        if k == 'kiln::ui::AlignmentV':
            return Mapping('float', lambda e: f'kiln::ui::AlignmentV{{ {e} }}', lambda e, o: f'({e}).bias')
        if k == 'kiln::foundation::Arrangement':
            vertical = 'vertical' in name.lower()
            return Mapping('kiln_arrangement', lambda e: f'kiln::capi::ToArrangement({e}, {str(vertical).lower()})',
                           lambda e, o: f'kiln::capi::FromArrangement({e})')
        if k == 'kiln::ui::DpSize':
            return Mapping('kiln_dp_size', lambda e: f'kiln::ui::DpSize{{ kiln::ui::Dp({e}.width), kiln::ui::Dp({e}.height) }}',
                           lambda e, o: f'kiln_dp_size{{ ({e}).width.value, ({e}).height.value }}')
        if k == 'kiln::ui::DpOffset':
            return Mapping('kiln_dp_offset', lambda e: f'kiln::ui::DpOffset{{ kiln::ui::Dp({e}.x), kiln::ui::Dp({e}.y) }}',
                           lambda e, o: f'kiln_dp_offset{{ ({e}).x.value, ({e}).y.value }}')
        if k == 'kiln::gfx::ImageBitmap':
            return Mapping('const kiln_image_bitmap*', lambda e: f'({e} ? {e}->bitmap : kiln::gfx::ImageBitmap{{}})', None)
        if k == 'std::shared_ptr<const kiln::gfx::vector::ImageVector>':
            return Mapping('const kiln_image_vector*', lambda e: f'({e} ? {e}->vector : nullptr)', None)
        if k.startswith('kiln::Function<kiln::rt::Task<float> (kiln::Function<float (float)>, float)>'):
            # foundation::FlingBehavior: an opaque handle from kiln (the carousel defaults).
            return Mapping('const kiln_fling_behavior*', lambda e: f'({e} ? {e}->fling : kiln::foundation::FlingBehavior{{}})',
                           lambda e, o: f'kiln::capi::TransientFling({e})')
        if k == 'kiln::foundation::ScrollIndicatorState':
            return Mapping('const kiln_scroll_indicator_state*', lambda e: f'kiln::capi::ToScrollIndicator({e})', None)
        if k == 'kiln::ui::AlignmentLine':
            # Lines are compared by address: a C handle is the line's own address.
            return Mapping('const kiln_alignment_line*', lambda e: f'*reinterpret_cast<const kiln::ui::AlignmentLine*>({e})',
                           lambda e, o: f'reinterpret_cast<const kiln_alignment_line*>(&{e})')
        if k == 'kiln::foundation::TextFieldState':
            return Mapping('kiln_text_field_state*', lambda e: f'*{e}->state', None)
        if k == 'kiln::foundation::ScrollState':
            return Mapping('kiln_scroll_state*', lambda e: f'*{e}->state', None)
        if k == 'kiln::foundation::LazyGridState':
            return Mapping('kiln_lazy_grid_state*', lambda e: f'*{e}->state', None)
        if k == 'kiln::foundation::LazyListState':
            return Mapping('kiln_lazy_list_state*', lambda e: f'*{e}->state', None)
        if k == 'kiln::foundation::BorderStroke':
            return Mapping('kiln_border_stroke', lambda e: f'kiln::foundation::BorderStroke(kiln::ui::Dp({e}.width), kiln::capi::ToColor({e}.color))',
                           lambda e, o: f'kiln::capi::FromBorderStroke({e})')
        if k == 'std::shared_ptr<kiln::foundation::MutableInteractionSource>':
            return Mapping('kiln_interaction_source*', lambda e: f'({e} ? {e}->source : nullptr)', lambda e, o: f'kiln::capi::TransientSource({e})')
        if k == 'kiln::gfx::shapes::RoundedPolygon':
            return Mapping('const kiln_rounded_polygon*', lambda e: f'({e} ? {e}->polygon : kiln::gfx::shapes::RoundedPolygon::Regular(3))',
                           lambda e, o: f'kiln::capi::TransientPolygon({e})')
        if k == 'kiln::foundation::WindowInsets':
            return Mapping('const kiln_window_insets*', lambda e: f'({e} ? {e}->insets : kiln::foundation::WindowInsets{{}})',
                           lambda e, o: f'kiln::capi::TransientInsets({e})')
        if k == 'std::shared_ptr<const kiln::foundation::CornerBasedShape>':
            return Mapping('const kiln_shape*', lambda e: f'std::dynamic_pointer_cast<const kiln::foundation::CornerBasedShape>(kiln::capi::ToShape({e}))',
                           lambda e, o: f'kiln::capi::TransientShape({e})')
        if k == 'kiln::foundation::CornerSize':
            return Mapping('kiln_corner_size', lambda e: f'kiln::capi::ToCornerSize({e})', lambda e, o: f'kiln::capi::FromCornerSize({e})')
        if k == 'kiln::text::TextUnit':
            return Mapping('kiln_text_unit', lambda e: f'kiln::capi::ToTextUnit({e})', lambda e, o: f'kiln::capi::FromTextUnit({e})')
        if k == 'kiln::ui::IntSize':
            return Mapping('kiln_int_size', lambda e: f'kiln::ui::IntSize{{ {e}.width, {e}.height }}', lambda e, o: f'kiln_int_size{{ ({e}).width, ({e}).height }}')
        if k == 'kiln::ui::Rect':
            return Mapping('kiln_rect', lambda e: f'kiln::ui::Rect{{ {e}.left, {e}.top, {e}.right, {e}.bottom }}',
                           lambda e, o: f'kiln_rect{{ ({e}).left, ({e}).top, ({e}).right, ({e}).bottom }}')
        if k == 'kiln::text::AnnotatedString':
            return Mapping('const kiln_annotated_string*', lambda e: f'({e} ? {e}->text : kiln::text::AnnotatedString{{}})', None)
        if k == 'kiln::foundation::ScrollableState':
            return Mapping('kiln_scrollable_state*', lambda e: f'*reinterpret_cast<kiln::foundation::ScrollableState*>({e})', None)
        if k == 'kiln::foundation::PagerState':
            # Returned from a state's method: `self` is that state's handle.
            return Mapping('kiln_pager_state*', lambda e: f'*{e}->state',
                           lambda e, o: f'kiln::capi::TransientPager({e}, self->scope, self->owner)')
        if arg_of_callback and k == 'kiln::Function<void ()>':
            # A callback handed to a callback (a text field's default keyboard action): to call
            # before the callback returns.
            return Mapping('kiln_fn', lambda e: f'kiln::capi::Fn({e})', lambda e, o: f'kiln::capi::TransientFn({e})')
        if k.startswith('kiln::Function<'):
            return self.callback(base, name)
        m = re.match(r'std::optional<(.*)>$', k)
        if m:
            inner = template_args(base)[0]
            ik = canon(inner)
            opt_scalar = {'bool': ('kiln_opt_bool', 'bool'), 'int': ('kiln_opt_int', 'int32_t'), 'float': ('kiln_opt_float', 'float'),
                          'long': ('kiln_opt_i64', 'int64_t'), 'long long': ('kiln_opt_i64', 'int64_t')}
            if ik in opt_scalar:
                c, _ = opt_scalar[ik]
                cpp = inner.get_canonical().spelling
                return Mapping(c, lambda e, cpp=cpp: f'({e}.set ? std::optional<{cpp}>({e}.value) : std::nullopt)',
                               lambda e, o, c=c, cpp=cpp: f'{c}{{ ({e}).has_value(), ({e}).value_or({cpp}{{}}) }}')
            if ik == 'kiln::ui::Dp':
                return Mapping('kiln_opt_float', lambda e: f'({e}.set ? std::optional<kiln::ui::Dp>(kiln::ui::Dp({e}.value)) : std::nullopt)',
                               lambda e, o: f'kiln_opt_float{{ ({e}).has_value(), ({e}) ? ({e})->value : 0.0f }}')
            if ik == 'kiln::ui::Color':
                return Mapping('kiln_color', lambda e: f'({e} ? std::optional<kiln::ui::Color>(kiln::capi::ToColor({e})) : std::nullopt)',
                               lambda e, o: f'(({e}) ? kiln::capi::FromColor(*({e})) : KILN_COLOR_UNSPECIFIED)')
            if ik in ('std::basic_string<char>',):
                return Mapping('const char*', lambda e: f'kiln::capi::ToOptString({e})',
                               lambda e, o: f'(({e}) ? kiln::capi::TransientString(*({e})) : nullptr)')
            if ik.startswith('std::optional<'):
                return self.nested_optional(inner, name)
            if ik == 'kiln::Function<void ()>':
                # unset (the default) / none (a NULL call) / a callback
                self.opt_structs['kiln_m3_opt_fn'] = 'kiln_fn'
                return Mapping('kiln_m3_opt_fn', lambda e: f'({e}.set ? std::optional<kiln::Function<void()>>(kiln::capi::Fn({e}.value)) : std::nullopt)', None)
            im = self.map(inner, name, field_=field_)
            if im.list_item is not None:
                return Mapping(im.c, None, None, list_item=im.list_item, list_optional=True)
            cpp_inner = inner.get_canonical().spelling
            # Pointer-shaped inner types: NULL is nullopt.
            if im.c.endswith('*'):
                return Mapping(im.c, lambda e, im=im, cpp=cpp_inner: f'({e} ? std::optional<{cpp}>({im.to_cpp(e)}) : std::nullopt)',
                               (lambda e, o, im=im: self.guarded_from(im, e)) if im.from_cpp else None)
            if im.by_out:
                st = im.struct
                return Mapping(f'const {st.c}*', lambda e, st=st, cpp=cpp_inner: f'({e} ? std::optional<{cpp}>(ToCpp({e})) : std::nullopt)',
                               lambda e, o, st=st: f'(({e}) ? FromCppTransient(*({e})) : nullptr)')
            # Value types: a pointer, NULL is nullopt.
            if im.c.startswith('kiln_') and not im.c.startswith('kiln_fn'):
                def from_opt(e, o, im=im):
                    lines = []
                    expr = im.from_cpp(f'(*({e}))', lines)
                    return f'([&]() -> const {im.c}* {{ if (!({e})) return nullptr; {" ".join(lines)} auto* p = kiln::capi::NewTransient<{im.c}>(); *p = {expr}; return p; }}())'
                return Mapping(f'const {im.c}*', lambda e, im=im, cpp=cpp_inner: f'({e} ? std::optional<{cpp}>({im.to_cpp("(*" + e + ")")}) : std::nullopt)',
                               from_opt if im.from_cpp else None)
            raise Unmappable(f'optional {k}')
        m = re.match(r'std::shared_ptr<(const )?(kiln::material3::[\w:]+)>$', k)
        if m and m.group(2) in self.records and m.group(2) in self.handle_quals:
            return self.handle_mapping(m.group(2), 'shared_const' if m.group(1) else 'shared')
        # A shared value struct: passed as the struct, shared on the C++ side.
        if m and m.group(2) in self.records and m.group(2) not in self.handle_quals:
            st = self.struct(m.group(2))
            q2 = m.group(2)
            return Mapping(f'const {st.c}*', lambda e, q2=q2: f'({e} ? std::make_shared<{q2}>(ToCpp({e})) : nullptr)',
                           lambda e, o: f'(({e}) ? FromCppTransient(*({e})) : nullptr)', by_out=False, struct=st)
        # Any other shared object (a position provider, a decay spec, a painter): an opaque
        # handle that comes from one call and goes back into another, transient like modifiers.
        m2 = re.match(r'std::shared_ptr<(const )?(kiln::[\w:]+)>$', k)
        if m2 and not any(p in SKIP_NAMESPACES for p in m2.group(2).split('::')):
            return self.opaque(m2.group(2), bool(m2.group(1)))
        d = base.get_canonical().get_declaration()
        if d.kind == ci.CursorKind.ENUM_DECL:
            return self.enum(base)
        q = qualname(d) if d.kind != ci.CursorKind.NO_DECL_FOUND else ''
        # Plain structs of the other kiln modules (DialogProperties, KeyboardOptions, Stroke).
        if q.startswith('kiln::') and q not in self.records and d.kind in (ci.CursorKind.STRUCT_DECL, ci.CursorKind.CLASS_DECL) \
                and d.is_definition() and not base.get_canonical().get_num_template_arguments() > 0:
            if self.public_fields(d) and not self.private_fields(d) and not self.non_copyable(d) \
                    and not any(p in SKIP_NAMESPACES for p in q.split('::')):
                self.records[q] = d
        if q in self.records:
            if any(p in SKIP_NAMESPACES for p in q.split('::')):
                raise Unmappable(f'{q} is internal')
            if q in self.handle_quals:
                return self.handle_mapping(q, 'ref')
            st = self.struct(q)
            return Mapping(f'const {st.c}*', lambda e: f'ToCpp({e})', lambda e, o: f'FromCppTransient({e})', by_out=True, struct=st)
        raise Unmappable(f'type {k}')

    # --- functions ---------------------------------------------------------------------------

    def unique(self, name, params, ctypes=None):
        """A C name for a function; overloads get a suffix that tells them apart: a parameter
        the first one lacks, else the type of the first parameter that differs."""
        ctypes = ctypes or [''] * len(params)
        if name not in self.names:
            self.names.add(name)
            self.base_sig[name] = list(zip(params, ctypes))
            return name
        base = self.base_sig.get(name, [])
        base_names = {p for p, _ in base}
        cands = [snake(p) for p in params if p not in base_names]
        for i, (p, t) in enumerate(zip(params, ctypes)):
            if i >= len(base) or base[i][1] != t:
                # A kiln struct or handle names an overload well; callbacks and numbers do not.
                if 'kiln_' in t and 'kiln_fn' not in t and 'kiln_m3_fn' not in t:
                    cands.append(re.sub(r'^(const )?kiln_(m3_)?', '', t).replace('*', '').strip())
                break
        cands += [snake(p) for p in params]
        for c in cands:
            cand = f'{name}_{c}'
            if cand not in self.names:
                self.names.add(cand)
                return cand
        i = 2
        while f'{name}_{i}' in self.names:
            i += 1
        self.names.add(f'{name}_{i}')
        return f'{name}_{i}'

    def emit_function(self, cur, owner=None):
        """A free function (owner None) or a handle method."""
        qual = qualname(cur)
        params = list(cur.get_arguments())
        optional_strings = set()
        c_params = []
        cpp_args = []
        prelude = []
        key_param = None
        names = []
        for i, p in enumerate(params):
            pname = p.spelling or f'arg{i}'
            if canon(strip_ref(p.type)[0]) == 'kiln::rt::Key':
                key_param = i
                cpp_args.append('kiln::capi::ToKey(key)')
                continue
            try:
                m = self.map(p.type, pname)
            except Unmappable as e:
                if has_default(p):
                    break   # the rest take their defaults
                self.skipped.append(f'{qual}: parameter {pname}: {e}')
                return
            cname = snake(pname)
            if cname in C_RESERVED:
                cname += '_'
            if m.c == 'const char*' and canon(strip_ref(p.type)[0]).startswith('std::optional<'):
                optional_strings.add(cname)
            c_params.append(f'{m.c} {cname}')
            names.append(pname)
            var = f'a{i}'
            prelude.append(f'auto&& {var} = {m.to_cpp(cname)};')
            cpp_args.append(f'std::forward<decltype({var})>({var})' if False else var)
        ret = cur.result_type
        ret_base, _ = strip_ref(ret)
        is_task = canon(ret_base).startswith('kiln::rt::Task<')
        retm = None
        vec_item = None
        if canon(ret_base).startswith('std::vector<') and not is_task:
            # A list: written to the caller's array (up to capacity); the count comes back.
            try:
                vec_item = self.map(template_args(ret_base)[0], '')
            except Unmappable as e:
                self.skipped.append(f'{qual}: result: list of {e}')
                return
            if vec_item.from_cpp is None or vec_item.by_out:
                self.skipped.append(f'{qual}: result: list of {ret.spelling}')
                return
        if ret.kind != ci.TypeKind.VOID and not is_task and vec_item is None:
            try:
                retm = self.map(ret, '')
            except Unmappable as e:
                self.skipped.append(f'{qual}: result: {e}')
                return
            if retm.from_cpp is None:
                self.skipped.append(f'{qual}: result {ret.spelling} cannot be returned')
                return
        task_cb = None
        if is_task and owner is None:
            self.skipped.append(f'{qual}: a suspending free function')
            return
        if is_task and canon(ret_base) != 'kiln::rt::Task<void>':
            try:
                task_cb = self.result_callback(template_args(ret_base)[0])
            except Unmappable as e:
                self.skipped.append(f'{qual}: suspending with a result: {e}')
                return
        # Names.
        if owner is None:
            ns = [p for p in qual.split('::')[2:-1]]
            base = 'kiln_m3_' + '_'.join(snake(x) for x in ns + [cur.spelling])
        else:
            base = f'{owner.c}_{snake(cur.spelling)}'
        cname = self.unique(base, names, [c.rsplit(' ', 1)[0] for c in c_params])
        # Signature.
        sig_params = []
        if owner is None:
            sig_params.append('kiln_key key')
        else:
            const = cur.is_const_method()
            sig_params.append(f'{"const " if const else ""}{owner.c}* self')
        sig_params += c_params
        # rememberX: the handle is remembered at the call (other functions return a transient one).
        handle_ret = retm is not None and retm.c.endswith('*') and retm.c.startswith('kiln_m3_') and not retm.c.startswith('const ') \
            and cur.spelling.startswith('Remember') and owner is None
        c_ret = 'void'
        if retm is not None:
            if retm.by_out:
                sig_params.append(f'{retm.struct.c}* out')
            else:
                c_ret = retm.c
        if is_task:
            sig_params.append(f'{task_cb.c if task_cb else "kiln_fn"} done')
        if vec_item is not None:
            item_c = vec_item.c if not vec_item.c.startswith('const ') else vec_item.c
            sig_params.append(f'{item_c}* items')
            sig_params.append('size_t capacity')
            c_ret = 'size_t'
        self.header_funcs.append((owner.c if owner else self.group_of(cur), f'KILN_API {c_ret} {cname}({", ".join(sig_params)});', cur))
        self.optional_strings[cname] = optional_strings
        # Body.
        call = f'{self.call_target(cur, owner)}({", ".join(cpp_args)})'
        body = []
        if owner is not None:
            body.append('if (!self) return {};' if c_ret != 'void' else 'if (!self) return;')
        body += prelude
        if vec_item is not None:
            body.append(f'std::optional<std::remove_cvref_t<decltype({call})>> r;')
            if owner is None and key_param is None:
                body.append(f'kiln::capi::InGroup(key, [&] {{ r.emplace({call}); }});')
            else:
                body.append(f'r.emplace({call});')
            lines = []
            expr = vec_item.from_cpp('(*r)[i]', lines)
            body.append(f'for (size_t i = 0; items && i < r->size() && i < capacity; ++i) {{ {" ".join(lines)} items[i] = {expr}; }}')
            body.append('return r->size();')
            self.glue_funcs.append((cname, c_ret, sig_params, body))
            return
        if is_task:
            body.append(f'auto* obj = self->ptr;')
            cap = ', '.join(['obj'] + [f'a{i}' for i in range(len(params)) if f'a{i}' in ' '.join(cpp_args)])
            body = [b.replace('auto&& a', 'auto a') for b in body]
            call_obj = call.replace('self->ptr->', 'obj->')
            if task_cb:
                body.append(f'auto cb = ToCpp_{task_cb.c}(done);')
                body.append(f'kiln::capi::LaunchIn(self->scope, [{cap}, cb]() mutable -> kiln::rt::Task<> {{ auto res = co_await {call_obj}; if (cb) cb(res); }}, kiln_fn{{}});')
            else:
                body.append(f'kiln::capi::LaunchIn(self->scope, [{cap}]() mutable {{ return {call_obj}; }}, done);')
        elif retm is None:
            if owner is None and key_param is None:
                body.append(f'kiln::capi::InGroup(key, [&] {{ {call}; }});')
            else:
                body.append(f'{call};')
        else:
            cpp_ret = ret.get_canonical().spelling
            store = 'std::optional<std::remove_cvref_t<decltype(' + call + ')>> r;'
            if ret.kind == ci.TypeKind.LVALUEREFERENCE:
                store = f'std::remove_reference_t<decltype({call})>* r = nullptr;'
                assign = f'r = &{call};'
                val = '(*r)'
            else:
                assign = f'r.emplace({call});'
                val = '(*r)'
            body.append(store)
            if handle_ret or (owner is None and key_param is None):
                if handle_ret:
                    body.append(f'{retm.c} out_handle = nullptr;')
                    body.append('kiln::capi::InGroup(key, [&] {')
                    body.append(f'    {assign}')
                    body.append(self.remember_handle(retm, ret))
                    body.append('});')
                    body.append('return out_handle;')
                    self.glue_funcs.append((cname, c_ret, sig_params, body))
                    return
                body.append(f'kiln::capi::InGroup(key, [&] {{ {assign} }});')
            else:
                body.append(assign)
            if retm.by_out:
                body.append(f'FromCpp({val}, out);')
            else:
                lines = []
                expr = retm.from_cpp(val, lines)
                body += lines
                body.append(f'return {expr};')
        self.glue_funcs.append((cname, c_ret, sig_params, body))

    def remember_handle(self, retm, ret):
        h = next(h for h in self.handles.values() if f'{h.c}*' == retm.c)
        shared = canon(strip_ref(ret)[0]).startswith('std::shared_ptr<')
        lines = ['    auto* cp = kiln::rt::Composition::Current();',
                 '    if (!cp) throw std::logic_error("a remember call outside content");',
                 '    auto& c = *cp;',
                 '    auto scope = kiln::rt::RememberCoroutineScope();',
                 f'    auto& h = c.Remember<{h.c}>([] {{ return {h.c}{{}}; }});']
        if shared:
            lines.append(f'    h.owner = std::const_pointer_cast<{h.qual}>(*r); h.ptr = h.owner.get();')
        elif ret.kind == ci.TypeKind.LVALUEREFERENCE:
            lines.append('    h.ptr = r;')
        else:   # a copyable handle returned by value
            lines.append(f'    h.owner = std::make_shared<{h.qual}>(std::move(*r)); h.ptr = h.owner.get();')
        lines.append('    h.scope = scope;')
        lines.append('    out_handle = &h;')
        return '\n'.join(lines)

    def call_target(self, cur, owner):
        if owner is not None:
            return f'self->ptr->{cur.spelling}'
        return qualname(cur)

    def group_of(self, cur):
        return os.path.basename(cur.location.file.name)

    def emit_local(self, cur, expr, local_type):
        """CompositionLocal: read it (`_current`) or provide a value to content (`_provide`)."""
        qual = qualname(cur)
        t = template_args(local_type)[0]
        try:
            m = self.map(t, '')
        except Unmappable as e:
            self.skipped.append(f'{qual}: local of {e}')
            return
        ns = qual.split('::')[2:-1]
        base = 'kiln_m3_' + '_'.join(snake(x) for x in ns + [cur.spelling])
        group = self.group_of(cur)
        if m.from_cpp is not None:
            name = self.unique(base + '_current', [])
            if m.by_out:
                sig = ['kiln_key key', f'{m.struct.c}* out']
                ret = 'void'
                body = [f'FromCpp(kiln::capi::CurrentComposition().Read({expr}), out);']
            else:
                sig = ['kiln_key key']
                ret = m.c
                lines = []
                e = m.from_cpp(f'kiln::capi::CurrentComposition().Read({expr})', lines)
                body = lines + [f'return {e};']
            body.insert(0, '(void)key;')
            self.header_funcs.append((group, f'KILN_API {ret} {name}({", ".join(sig)});', cur))
            self.glue_funcs.append((name, ret, sig, body))
        name = self.unique(base + '_provide', [])
        sig = ['kiln_key key', f'{m.c} value', 'kiln_fn content']
        body = [f'auto fn = kiln::capi::Fn(content);',
                f'kiln::capi::CurrentComposition().Provide({expr}, {t.get_canonical().spelling}({m.to_cpp("value")}), fn ? fn : [] {{}}, kiln::capi::ToKey(key));']
        self.header_funcs.append((group, f'KILN_API void {name}({", ".join(sig)});', cur))
        self.glue_funcs.append((name, 'void', sig, body))

    def emit_constant(self, cur):
        """A namespace constant (ButtonDefaults::MinWidth): a getter."""
        qual = qualname(cur)
        try:
            m = self.map(cur.type, '')
        except Unmappable as e:
            self.skipped.append(f'{qual}: constant: {e}')
            return
        if m.from_cpp is None:
            self.skipped.append(f'{qual}: constant cannot be returned')
            return
        ns = qual.split('::')[2:-1]
        name = self.unique('kiln_m3_' + '_'.join(snake(x) for x in ns + [cur.spelling]), [])
        if m.by_out:
            sig, ret, body = [f'{m.struct.c}* out'], 'void', [f'FromCpp({qual}, out);']
        else:
            lines = []
            e = m.from_cpp(qual, lines)
            sig, ret, body = ['void'], m.c, lines + [f'return {e};']
        self.header_funcs.append((self.group_of(cur), f'KILN_API {ret} {name}({", ".join(sig)});', cur))
        self.glue_funcs.append((name, ret, [] if sig == ['void'] else sig, body))

    def reserve_type_names(self):
        for h in self.handles.values():
            self.names.add(h.c)
        for st in self.structs.values():
            self.names.add(st.c)
            self.names.add(st.c + '_init')
        for e in self.enums.values():
            self.names.add(e.c)
        for cb in self.callbacks.values():
            self.names.add(cb.c)

    def emit_methods(self, h):
        if h.cursor is None:
            return
        for ch in h.cursor.get_children():
            if ch.kind != ci.CursorKind.CXX_METHOD or ch.access_specifier != ci.AccessSpecifier.PUBLIC or is_internal(ch):
                continue
            if ch.is_static_method() or ch.spelling.startswith('operator') or ch.is_deleted_method():
                continue
            if ch.is_virtual_method() and h.cursor.spelling.endswith('Scope'):
                pass
            self.emit_function(ch, owner=h)

    def run(self):
        self.collect()
        funcs = []
        locals_ = []
        constants = []
        def walk(c, ns):
            for ch in c.get_children():
                if ch.kind == ci.CursorKind.NAMESPACE:
                    if ch.spelling in SKIP_NAMESPACES:
                        continue
                    walk(ch, ns + [ch.spelling])
                elif ch.kind == ci.CursorKind.FUNCTION_DECL and ns[:2] == ['kiln', 'material3'] and self.in_m3(ch):
                    if ch.spelling.startswith('operator') or is_internal(ch):
                        continue
                    if canon(strip_ref(ch.result_type)[0]).startswith('kiln::rt::Local<'):
                        locals_.append((ch, qualname(ch) + '()', strip_ref(ch.result_type)[0]))
                        continue
                    funcs.append(ch)
                elif ch.kind == ci.CursorKind.VAR_DECL and ns[:2] == ['kiln', 'material3'] and self.in_m3(ch) and not is_internal(ch):
                    if canon(ch.type).startswith('kiln::rt::Local<'):
                        locals_.append((ch, qualname(ch), ch.type))
                    else:
                        constants.append(ch)
                elif ch.kind in (ci.CursorKind.STRUCT_DECL, ci.CursorKind.CLASS_DECL) and ch.is_definition() and ns[:2] == ['kiln', 'material3'] \
                        and self.in_m3(ch):
                    # Static methods (MaterialTheme::colorScheme()) are free functions.
                    for m in ch.get_children():
                        if m.kind == ci.CursorKind.CXX_METHOD and m.is_static_method() and m.access_specifier == ci.AccessSpecifier.PUBLIC \
                                and not m.spelling.startswith('operator') and not is_internal(m):
                            funcs.append(m)
        walk(self.tu.cursor, [])
        # Types first, so function names never take a type's name.
        for f in funcs:
            for p in list(f.get_arguments()) + []:
                try:
                    self.map(p.type, p.spelling)
                except Unmappable:
                    pass
        self.reserve_type_names()
        seen = set()
        for f in funcs:
            usr = f.get_usr()
            if usr in seen:
                continue
            seen.add(usr)
            self.emit_function(f)
        for cur, expr, t in locals_:
            self.emit_local(cur, expr, t)
        for cur in constants:
            self.emit_constant(cur)
        done = set()
        while True:
            pending = [h for q, h in self.handles.items() if q not in done]
            if not pending:
                break
            for h in pending:
                done.add(h.qual)
                self.emit_methods(h)

    # --- output ------------------------------------------------------------------------------

    def header(self):
        out = ['/* Material 3 over the kiln C ABI. Generated by tools/gen-capi from the material3 headers: do not',
               ' * edit. See kiln.h for the rules; in short, every function takes a kiln_key first and runs in',
               ' * its own group, structs pass by pointer (NULL: the defaults) and come back through `out`',
               ' * pointers whose `size` the caller set (use the _init functions), and handles returned by',
               ' * kiln_m3_remember_* live as long as their call stays in the composition. */',
               '#ifndef KILN_M3_H', '#define KILN_M3_H', '', '#include <kiln/kiln.h>', '',
               '#ifdef __cplusplus', 'extern "C" {', '#endif', '']
        out.append('/* Handles */')
        for h in sorted(self.handles.values(), key=lambda h: h.c):
            out.append(f'typedef struct {h.c} {h.c};')
        out.append('/* Opaque objects: from one call, back into another; valid until the outermost callback returns. */')
        for c in sorted(self.opaques):
            out.append(f'typedef struct {c} {c};')
        out.append('')
        out.append('/* Structs */')
        for q in self.struct_order:
            s = self.structs[q]
            out.append(f'typedef struct {s.c} {s.c};')
        out.append('')
        out.append('/* Enums */')
        for e in sorted(self.enums.values(), key=lambda e: e.c):
            out.append(f'typedef enum {e.c} {{')
            for n, v in e.values:
                out.append(f'    {e.c.upper()}_{snake(n).upper()} = {v},')
            out.append(f'}} {e.c};')
        out.append('')
        out.append('/* Callbacks */')
        for cb in sorted(self.callbacks.values(), key=lambda c: c.c):
            args = ''.join(f', {m.c} a{i}' for i, (m, _) in enumerate(cb.args))
            if getattr(cb, 'ret_struct', None):
                args += f', {cb.ret_struct.c}* out'
            r = cb.ret.c if cb.ret else 'void'
            out.append(f'typedef struct {cb.c} {{ {r} (*call)(void* user{args}); void* user; void (*drop)(void* user); }} {cb.c};')
        out.append('')
        out.append('/* Nested optionals: set false keeps the default; set with value NULL is none. */')
        for c, ptr in sorted(self.opt_structs.items()):
            out.append(f'typedef struct {c} {{ bool set; {ptr} value; }} {c};')
        out.append('')
        out.append('/* Struct definitions */')
        for q in self.struct_order:
            s = self.structs[q]
            out.append(f'struct {s.c} {{')
            out.append('    size_t size;')
            for n, m, _ in s.fields:
                if m.list_item is not None:
                    out.append(f'    {m.c} {field_name(n)};   /* NULL: the default */')
                    out.append(f'    size_t {field_name(n)}_count;')
                    continue
                if m.c.startswith('const kiln_m3_') and m.by_out:
                    out.append(f'    {m.c} {field_name(n)};   /* NULL: the default */')
                else:
                    out.append(f'    {m.c} {field_name(n)};')
            out.append('};')
            out.append(f'KILN_API void {s.c}_init({s.c}* s);')
        out.append('')
        out.append('/* Functions */')
        group = None
        for g, decl, _ in self.header_funcs:
            if g != group:
                out.append(f'/* {g} */')
                group = g
            out.append(decl)
        out += ['', '#ifdef __cplusplus', '}', '#endif', '', '#endif', '']
        return '\n'.join(out)

    def rust_module(self):
        """bindings/rust/kiln/src/material3.rs: every kiln_m3 function with closures, &str,
        Modifier and the call site's key; structs come back by value."""
        cbs = {cb.c: cb for cb in self.callbacks.values()}
        core_cbs = {'kiln_fn', 'kiln_fn_bool', 'kiln_fn_int', 'kiln_fn_float', 'kiln_fn_str'}
        structs = {self.structs[q].c for q in self.struct_order}
        scalars = {'bool': 'bool', 'int32_t': 'i32', 'uint32_t': 'u32', 'float': 'f32', 'double': 'f64', 'int64_t': 'i64',
                   'uint64_t': 'u64', 'uint8_t': 'u8', 'size_t': 'usize', 'kiln_color': 'sys::kiln_color'}

        def rty(t):
            t = t.strip()
            if t in scalars:
                return scalars[t]
            if t == 'const char*':
                return '*const std::ffi::c_char'
            m = re.match(r'^(const )?(\w+)\s*(\*+)?\s*(const\*)?$', t.replace(' const*', ' const*'))
            if t.endswith(' const*'):
                inner = t[:-len(' const*')].strip()
                return f'*const {rty(inner)}'
            const, name, stars = m.group(1), m.group(2), m.group(3) or ''
            base = scalars.get(name, f'sys::{name}')
            # `const` binds to the innermost pointer: const T** is *mut *const T.
            for i, _ in enumerate(stars):
                base = f'*const {base}' if (const and i == 0) else f'*mut {base}'
            return base

        def ident(n):
            if n in ('self', 'Self', 'super', 'crate'):
                return 'this' if n == 'self' else n + '_'
            return f'r#{n}' if n in RUST_RESERVED else n

        def parse(decl):
            m = re.match(r'KILN_API (.+?) (\w+)\((.*)\);$', decl)
            ret, name, params = m.group(1), m.group(2), m.group(3)
            ps = [] if params in ('', 'void') else [p.strip() for p in params.split(', ')]
            out = []
            for p in ps:
                t, n = p.rsplit(' ', 1)
                while n.startswith('*'):
                    t += '*'
                    n = n[1:]
                out.append((t.strip(), n))
            return ret, name, out

        out = ['//! Material 3: every function of kiln_m3.h. Generated by tools/gen-capi: do not edit.',
               '//! Callbacks take closures, strings `&str`, the key is the call site; struct results come',
               '//! back by value; handles are the raw `sys` pointers (see kiln_m3.h for each one\'s life).',
               '#![allow(clippy::too_many_arguments, unused_imports, non_snake_case)]',
               'use crate::{here, sys, CStrBuf, IntoCallback, Modifier};', '']
        for cb in sorted(self.callbacks.values(), key=lambda c: c.c):
            args = ', '.join([f'a{i}: {rty(m.c)}' for i, (m, _) in enumerate(cb.args)]
                             + ([f'out: *mut sys::{cb.ret_struct.c}'] if getattr(cb, 'ret_struct', None) else []))
            r = rty(cb.ret.c) if cb.ret else '()'
            out.append(f'crate::__kiln_callback!(sys::{cb.c}, ({args}) -> {r});')
        out.append('')
        for group, decl, cur in self.header_funcs:
            ret, name, params = parse(decl)
            if not name.startswith('kiln_m3_'):
                continue
            rname = ident(name[len('kiln_m3_'):])
            decls, pre, args, generics = [], [], [], []
            out_struct = None
            has_key = False
            for t, n in params:
                bare = t.replace('const ', '').replace('*', '').strip()
                rn = ident(n)
                if n == 'key' and t == 'kiln_key':
                    has_key = True
                    args.append('here()')
                elif n == 'out' and bare in structs:
                    out_struct = bare
                    args.append('&mut out')
                elif t in cbs or t in core_cbs:
                    decls.append(f'{rn}: impl IntoCallback<sys::{t}>')
                    args.append(f'{rn}.into_callback()')
                elif t == 'const kiln_alignment_line*':
                    decls.append(f'{rn}: crate::AlignmentLine')
                    args.append(f'{rn}.0')
                elif t == 'const kiln_modifier*':
                    decls.append(f'{rn}: Modifier')
                    args.append(f'{rn}.raw()')
                elif t == 'const char*' and n in self.optional_strings.get(name, set()):
                    decls.append(f'{rn}: Option<&str>')
                    pre.append(f'let {n}_c = {rn}.map(CStrBuf::new);')
                    args.append(f'{n}_c.as_ref().map_or(std::ptr::null(), |c| c.ptr())')
                elif t == 'const char*':
                    decls.append(f'{rn}: &str')
                    pre.append(f'let {n}_c = CStrBuf::new({rn});')
                    args.append(f'{n}_c.ptr()')
                else:
                    decls.append(f'{rn}: {rty(t)}')
                    args.append(rn)
            call = f'sys::{name}({", ".join(args)})'
            attr = '#[track_caller]' if has_key else ''
            if out_struct:
                body = pre + [f'let mut out: sys::{out_struct} = Default::default();', f'unsafe {{ sys::{out_struct}_init(&mut out); {call}; }}', 'out']
                rt = f' -> sys::{out_struct}'
            elif ret == 'void':
                body = pre + [f'unsafe {{ {call} }}']
                rt = ''
            elif ret == 'const char*':
                body = pre + [f'crate::from_c(unsafe {{ {call} }})']
                rt = ' -> String'
            elif ret == 'const kiln_alignment_line*':
                body = pre + [f'crate::AlignmentLine(unsafe {{ {call} }})']
                rt = ' -> crate::AlignmentLine'
            else:
                body = pre + [f'unsafe {{ {call} }}']
                rt = f' -> {rty(ret)}'
            if attr:
                out.append(attr)
            out.append(f'pub fn {rname}({", ".join(decls)}){rt} {{')
            for b in body:
                out.append(f'    {b}')
            out.append('}')
        out.append('')
        return '\n'.join(out)

    def cpp_header(self):
        """kiln_m3.hpp: kiln++ wrappers (callables for callbacks, Key last, structs returned)."""
        cbs = {cb.c for cb in self.callbacks.values()} | {'kiln_fn', 'kiln_fn_bool', 'kiln_fn_int', 'kiln_fn_float', 'kiln_fn_str'}
        structs = {self.structs[q].c for q in self.struct_order}
        handles = {h.c: h for h in self.handles.values()}

        def cls(h):
            return ''.join(p for p in h.qual.split('::')[2:])

        def ident(n):
            return n + '_' if n in CPP_RESERVED else n

        def parse(decl):
            m = re.match(r'KILN_API (.+?) (\w+)\((.*)\);$', decl)
            ret, name, params = m.group(1), m.group(2), m.group(3)
            ps = [] if params in ('', 'void') else [p.strip() for p in params.split(', ')]
            out = []
            for p in ps:
                t, n = p.rsplit(' ', 1)
                while n.startswith('*'):
                    t += '*'
                    n = n[1:]
                out.append((t.strip(), n))
            return ret, name, out

        def wrap_params(params):
            """C++ parameters, the C arguments, and whether a struct comes back through `out`."""
            decl, args = [], []
            out_struct = None
            for t, n in params:
                bare = t.replace('const ', '').replace('*', '').strip()
                if n == 'out' and bare in structs:
                    out_struct = bare
                    continue
                if n == 'key' and t == 'kiln_key':
                    continue
                if t in cbs:
                    decl.append([f'kpp::Callback<{t}> {ident(n)}', True])
                    args.append(f'{ident(n)}.release()')
                elif t == 'const kiln_modifier*':
                    decl.append([f'kpp::Modifier {ident(n)}', True])
                    args.append(ident(n))
                elif t == 'const char*':
                    decl.append([f'kpp::Str {ident(n)}', False])
                    args.append(f'{ident(n)}.c_str()')
                elif t.rstrip('*').strip() in handles and t.endswith('*'):
                    decl.append([f'{cls(handles[t.rstrip("*").strip()])} {ident(n)}', False])
                    args.append(ident(n))
                else:
                    # Pointers, colours and optionals: zero is "unset".
                    zero_ok = t.endswith('*') or t == 'kiln_color' or t.startswith('kiln_opt_') or t.startswith('kiln_m3_opt_')
                    decl.append([f'{t} {ident(n)}', zero_ok])
                    args.append(ident(n))
            # Defaults for the trailing pointers, modifiers and callbacks.
            for d in reversed(decl):
                if not d[1]:
                    break
                d[0] += ' = {}'
            return [d[0] for d in decl], args, out_struct

        out = ['// kiln++ for Material 3: wrappers over kiln_m3.h. Generated by tools/gen-capi: do not edit.',
               '// Callbacks take callables, the key comes last (the call site by default), structs come back',
               '// by value, handles are small classes with their methods.',
               '#pragma once', '', '#include <kiln/kiln_m3.h>', '#include <kiln/kilnpp.hpp>', '', 'namespace kpp::m3 {', '']
        # Handle classes first (declared, then defined after the functions they use).
        for h in sorted(handles.values(), key=lambda h: h.c):
            out.append(f'    class {cls(h)};')
        out.append('')
        methods = {}
        free = []
        for group, decl, cur in self.header_funcs:
            ret, name, params = parse(decl)
            if group in handles and params and params[0][1] == 'self':
                methods.setdefault(group, []).append((ret, name, params))
            else:
                free.append((ret, name, params))
        def ret_wrap(r, expr):
            """The C++ return type and expression for a C result."""
            if r.rstrip('*').strip() in handles and r.endswith('*'):
                c = cls(handles[r.rstrip('*').strip()])
                return c, f'{c}({expr})'
            if r == 'const char*':
                return 'std::string', f'std::string({expr} ? {expr} : "")'.replace(f'{expr} ? {expr}', f'kpp::detail::Nz({expr})').replace(' : "")', ')')
            if r == 'const kiln_modifier*':
                return 'kpp::Modifier', f'kpp::Modifier(const_cast<kiln_modifier*>({expr}))'
            return r, expr

        defs = []
        for h in sorted(handles.values(), key=lambda h: h.c):
            c = cls(h)
            out.append(f'    class {c} {{')
            out.append('    public:')
            out.append(f'        {c}({h.c}* h = nullptr) : m_H(h) {{}}')
            out.append(f'        operator {h.c}*() const {{ return m_H; }}')
            out.append(f'        {h.c}* get() const {{ return m_H; }}')
            out.append('        explicit operator bool() const { return m_H != nullptr; }')
            for ret, name, params in methods.get(h.c, []):
                decl, args, out_struct = wrap_params(params[1:])
                mname = ident(name[len(h.c) + 1:])
                call_args = ''.join(', ' + a for a in args)
                plain = [d.split(' = ')[0] for d in decl]
                if out_struct:
                    out.append(f'        {out_struct} {mname}({", ".join(decl)}) const;')
                    defs.append(f'    inline {out_struct} {c}::{mname}({", ".join(plain)}) const {{ {out_struct} o; {out_struct}_init(&o); {name}(m_H{call_args}, &o); return o; }}')
                elif ret == 'void':
                    out.append(f'        void {mname}({", ".join(decl)}) const;')
                    defs.append(f'    inline void {c}::{mname}({", ".join(plain)}) const {{ {name}(m_H{call_args}); }}')
                else:
                    r, e = ret_wrap(ret, f'{name}(m_H{call_args})')
                    out.append(f'        {r} {mname}({", ".join(decl)}) const;')
                    defs.append(f'    inline {r} {c}::{mname}({", ".join(plain)}) const {{ return {e}; }}')
            out.append('    private:')
            out.append(f'        {h.c}* m_H;')
            out.append('    };')
        out.append('')
        out += defs
        out.append('')
        for ret, name, params in free:
            short = ident(name[len('kiln_m3_'):])
            has_key = bool(params) and params[0] == ('kiln_key', 'key')
            decl, args, out_struct = wrap_params(params)
            if has_key:
                decl.append('kpp::Key key = {}')
                args.insert(0, 'key')
            if out_struct:
                out.append(f'    inline {out_struct} {short}({", ".join(decl)}) {{ {out_struct} o; {out_struct}_init(&o); {name}({", ".join(args + ["&o"])}); return o; }}')
            elif ret == 'void':
                out.append(f'    inline void {short}({", ".join(decl)}) {{ {name}({", ".join(args)}); }}')
            else:
                r, e = ret_wrap(ret, f'{name}({", ".join(args)})')
                out.append(f'    inline {r} {short}({", ".join(decl)}) {{ return {e}; }}')
        out += ['', '}', '']
        return '\n'.join(out)

    def glue(self, includes):
        out = ['// Generated by tools/gen-capi from the material3 headers: do not edit.', '',
               '#include "kiln/capi/CApiSupport.h"', '#include <kiln/kiln_m3.h>', '']
        out += [f'#include "kiln/material3/{os.path.basename(h)}"' for h in includes]
        out += ['', '#include <optional>', '#include <type_traits>', '']
        for h in sorted(self.handles.values(), key=lambda h: h.c):
            out.append(f'struct {h.c} : kiln::capi::Handle<{h.qual}> {{}};')
        for c in sorted(self.opaques):
            out.append(f'struct {c} {{ std::shared_ptr<const void> p; }};')
        out += ['', 'namespace {', '']
        # Struct converters: declarations, then definitions.
        for q in self.struct_order:
            s = self.structs[q]
            out.append(f'[[maybe_unused]] {q} ToCpp(const {s.c}* c);')
            out.append(f'[[maybe_unused]] void FromCpp(const {q}& v, {s.c}* out);')
            out.append(f'[[maybe_unused]] const {s.c}* FromCppTransient(const {q}& v);')
        for cb in self.callbacks.values():
            out.append(f'[[maybe_unused]] {cb.cpp_sig} ToCpp_{cb.c}({cb.c} f);')
        out.append('')
        for cb in self.callbacks.values():
            params = ', '.join(f'{t} x{i}' for i, (_, t) in enumerate(cb.args))
            lines = []
            cargs = ''.join(', ' + m.from_cpp(f'x{i}', lines) for i, (m, _) in enumerate(cb.args))
            out.append(f'{cb.cpp_sig} ToCpp_{cb.c}({cb.c} f) {{')
            out.append('    auto o = kiln::capi::Own(f);')
            out.append('    if (!o) return {};')
            out.append(f'    return [o]({params}) -> {cb.ret_cpp} {{')
            out.append('        kiln::capi::CallbackScope scope;')
            post = [l[len('@post '):] for l in lines if l.startswith('@post ')]
            for l in lines:
                if not l.startswith('@post '):
                    out.append('        ' + l)
            if getattr(cb, 'ret_struct', None):
                st = cb.ret_struct
                out.append(f'        {st.c} r;')
                out.append(f'        {st.c}_init(&r);')
                out.append(f'        o->f.call(o->f.user{cargs}, &r);')
                for l in post:
                    out.append('        ' + l)
                out.append('        return ToCpp(&r);')
            elif cb.ret:
                out.append(f'        auto r = o->f.call(o->f.user{cargs});')
                for l in post:
                    out.append('        ' + l)
                out.append(f'        return {cb.ret.to_cpp("r")};')
            else:
                out.append(f'        o->f.call(o->f.user{cargs});')
                for l in post:
                    out.append('        ' + l)
            out.append('    };')
            out.append('}')
        for cb in self.callbacks.values():
            if cb.c not in self.returned_callbacks:
                continue
            # A C++ function as the C callback struct: call converts the C arguments in and the
            # result out; drop frees it.
            cparams = ''.join(f', {m.c} a{i}' for i, (m, _) in enumerate(cb.args))
            cpp_args = ', '.join(m.to_cpp(f'a{i}') for i, (m, _) in enumerate(cb.args))
            r = cb.ret.c if cb.ret else 'void'
            out.append(f'[[maybe_unused]] {cb.c} FromCpp_{cb.c}({cb.cpp_sig} fn) {{')
            out.append(f'    using F = {cb.cpp_sig};')
            out.append(f'    {cb.c} c{{}};')
            out.append('    if (!fn) return c;')
            out.append('    c.user = new F(std::move(fn));')
            if cb.ret:
                lines = []
                expr = cb.ret.from_cpp(f'(*static_cast<F*>(u))({cpp_args})', lines)
                out.append(f'    c.call = [](void* u{cparams}) -> {r} {{ {" ".join(lines)} return {expr}; }};')
            else:
                out.append(f'    c.call = [](void* u{cparams}) {{ (*static_cast<F*>(u))({cpp_args}); }};')
            out.append('    c.drop = [](void* u) { delete static_cast<F*>(u); };')
            out.append('    return c;')
            out.append('}')
        for q in self.struct_order:
            s = self.structs[q]
            out.append(f'{q} ToCpp(const {s.c}* in) {{')
            out.append(f'    {q} v{{}};')
            out.append('    if (!in) return v;')
            out.append(f'    {s.c} c;')
            out.append(f'    {s.c}_init(&c);')
            out.append('    if (in->size > sizeof(size_t)) std::memcpy(reinterpret_cast<char*>(&c) + sizeof(size_t), reinterpret_cast<const char*>(in) + sizeof(size_t), std::min(in->size, sizeof(c)) - sizeof(size_t));')
            for n, m, _ in s.fields:
                f = field_name(n)
                if m.list_item is not None:
                    if m.list_optional:
                        out.append(f'    if (c.{f}) {{ v.{n}.emplace(); for (size_t i = 0; i < c.{f}_count; ++i) v.{n}->push_back({m.list_item.to_cpp(f"c.{f}[i]")}); }}')
                    else:
                        out.append(f'    if (c.{f}) {{ v.{n}.clear(); for (size_t i = 0; i < c.{f}_count; ++i) v.{n}.push_back({m.list_item.to_cpp(f"c.{f}[i]")}); }}')
                    continue
                if m.c.startswith('kiln_m3_opt_'):
                    out.append(f'    if (c.{f}.set) v.{n} = {m.to_cpp("c." + f)};')
                elif m.c.endswith('*') or m.c.startswith('kiln_fn') or m.c.startswith('kiln_m3_fn'):
                    cond = f'c.{f}' if m.c.endswith('*') else f'c.{f}.call'
                    out.append(f'    if ({cond}) v.{n} = {m.to_cpp("c." + f)};')
                else:
                    out.append(f'    v.{n} = {m.to_cpp("c." + f)};')
            out.append('    return v;')
            out.append('}')
            out.append(f'void FromCpp(const {q}& v, {s.c}* out) {{')
            out.append('    (void)v;')
            out.append('    if (!out) return;')
            out.append(f'    {s.c} c{{}};')
            out.append('    c.size = sizeof(c);')
            for n, m, _ in s.fields:
                f = field_name(n)
                if m.from_cpp is None or m.c.startswith('kiln_fn') or m.c.startswith('kiln_m3_fn'):
                    continue
                lines = []
                expr = m.from_cpp(f'v.{n}', lines)
                for l in lines:
                    out.append('    ' + l)
                out.append(f'    c.{f} = {expr};')
            out.append('    const size_t n = out->size < sizeof(size_t) ? sizeof(c) : std::min(out->size, sizeof(c));')
            out.append('    std::memcpy(reinterpret_cast<char*>(out) + sizeof(size_t), reinterpret_cast<const char*>(&c) + sizeof(size_t), n - sizeof(size_t));')
            out.append('    out->size = n;')
            out.append('}')
            out.append(f'const {s.c}* FromCppTransient(const {q}& v) {{')
            out.append(f'    auto* c = kiln::capi::NewTransient<{s.c}>();')
            out.append('    c->size = sizeof(*c);')
            out.append('    FromCpp(v, c);')
            out.append('    return c;')
            out.append('}')
        out += ['', '}', '']
        for q in self.struct_order:
            s = self.structs[q]
            out.append(f'KILN_API void {s.c}_init({s.c}* s) {{')
            out.append('    if (!s) return;')
            out.append(f'    KILN_CAPI_TRY {{ s->size = sizeof(*s); FromCpp({q}{{}}, s); }} KILN_CAPI_CATCH()')
            out.append('}')
        out.append('')
        for cname, c_ret, sig, body in self.glue_funcs:
            out.append(f'KILN_API {c_ret} {cname}({", ".join(sig)}) {{')
            out.append('    KILN_CAPI_TRY {')
            for b in body:
                for line in b.split('\n'):
                    out.append('        ' + line)
            out.append('    } KILN_CAPI_CATCH(' + ('' if c_ret == 'void' else '{}') + ')')
            out.append('}')
        out.append('')
        return '\n'.join(out)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--build', default=os.path.join(ROOT, 'build/host'))
    args = ap.parse_args()
    db = json.load(open(os.path.join(args.build, 'compile_commands.json')))
    entry = next(e for e in db if '/material3/src/' in e['file'])
    argv = shlex.split(entry['command'])[1:]
    flags = []
    skip = False
    for a in argv:
        if skip:
            skip = False
            continue
        if a in ('-o', '-c'):
            skip = True
            continue
        if a.startswith('-W') or a.endswith('.cpp') or a.startswith('-std='):
            continue
        flags.append(a)
    resource = subprocess.run(['clang', '-print-resource-dir'], capture_output=True, text=True).stdout.strip()
    flags += ['-x', 'c++', '-std=c++23', '-resource-dir', resource, '-I', os.path.join(ROOT, 'material3/src')]
    headers = sorted(glob.glob(os.path.join(M3_DIR, '*.h')))
    umbrella = '\n'.join(f'#include "{h}"' for h in headers) + '\n'
    idx = ci.Index.create()
    tu = idx.parse('kiln_m3_umbrella.cpp', args=flags, unsaved_files=[('kiln_m3_umbrella.cpp', umbrella)])
    errors = [d for d in tu.diagnostics if d.severity >= ci.Diagnostic.Error]
    if errors:
        for d in errors[:10]:
            print(d, file=sys.stderr)
        sys.exit('parse errors')
    g = Generator(tu)
    g.run()
    with open(os.path.join(ROOT, 'include/kiln/kiln_m3.h'), 'w') as f:
        f.write(g.header())
    with open(os.path.join(ROOT, 'include/kiln/kiln_m3.hpp'), 'w') as f:
        f.write(g.cpp_header())
    with open(os.path.join(ROOT, 'bindings/rust/kiln/src/material3.rs'), 'w') as f:
        f.write(g.rust_module())
    os.makedirs(os.path.join(ROOT, 'material3/src/kiln/capi'), exist_ok=True)
    with open(os.path.join(ROOT, 'material3/src/kiln/capi/M3CApi.gen.cpp'), 'w') as f:
        f.write(g.glue(headers))
    with open(os.path.join(ROOT, 'material3/src/kiln/capi/M3CApi.skipped.txt'), 'w') as f:
        f.write('# Declarations tools/gen-capi could not map (generated).\n')
        for s in sorted(set(g.skipped)):
            f.write(s + '\n')
        for q in g.struct_order:
            for n, why in g.structs[q].omitted:
                f.write(f'{q}::{n}: field left at its default: {why}\n')
    print(f'{len(g.glue_funcs)} functions, {len(g.structs)} structs, {len(g.handles)} handles, {len(g.enums)} enums, '
          f'{len(g.callbacks)} callback types; {len(set(g.skipped))} skipped')


if __name__ == '__main__':
    main()
