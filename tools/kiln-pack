#!/usr/bin/env bash
# kiln-pack: builds an APK from a kiln app's native library without Gradle.
#
#   kiln-pack --package dev.example.app --label "App" --lib-name hello \
#             --lib arm64-v8a=path/libhello.so [--lib x86_64=path/libhello.so] [--assets dir] [--debug] --out app.apk
#
# --debug: a debuggable APK that answers Volition (content://<package>.volition), so the
# volition CLI and MCP tools drive it by name.
# Also: --permission name (repeatable), --icon file.png (the launcher icon, 192 px),
# --version-code n, --version-name text, --manifest-xml file / --application-xml file (elements
# added to <manifest> / <application>), --keystore file --key-alias name (sign with your key:
# passwords from KILN_KEYSTORE_PASSWORD and KILN_KEY_PASSWORD; default: kiln's debug key).
#
# Steps: javac (kiln's Java host, platform APIs only) -> d8 -> manifest -> aapt2 link ->
# add classes.dex + lib/<abi>/*.so -> zipalign -> apksigner (debug key in build/).
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/android-env.sh"
PACKAGE=""; LABEL="kiln app"; LIBNAME=""; OUT=""; LIBS=(); ASSETS=""; DEBUG=0
PERMISSIONS=(); ICON=""; VERSION_CODE=1; VERSION_NAME="1.0"; MANIFEST_XML=""; APPLICATION_XML=""; KEYSTORE_ARG=""; KEY_ALIAS=""
while [ $# -gt 0 ]; do
    case "$1" in
        --package) PACKAGE="$2"; shift 2 ;;
        --label) LABEL="$2"; shift 2 ;;
        --lib-name) LIBNAME="$2"; shift 2 ;;
        --lib) LIBS+=("$2"); shift 2 ;;
        --out) OUT="$2"; shift 2 ;;
        --assets) ASSETS="$2"; shift 2 ;;
        --debug) DEBUG=1; shift ;;
        --permission) PERMISSIONS+=("$2"); shift 2 ;;
        --icon) ICON="$2"; shift 2 ;;
        --version-code) VERSION_CODE="$2"; shift 2 ;;
        --version-name) VERSION_NAME="$2"; shift 2 ;;
        --manifest-xml) MANIFEST_XML="$2"; shift 2 ;;
        --application-xml) APPLICATION_XML="$2"; shift 2 ;;
        --keystore) KEYSTORE_ARG="$2"; shift 2 ;;
        --key-alias) KEY_ALIAS="$2"; shift 2 ;;
        *) echo "kiln-pack: unknown argument $1" >&2; exit 2 ;;
    esac
done
[ -n "$PACKAGE" ] && [ -n "$LIBNAME" ] && [ -n "$OUT" ] && [ ${#LIBS[@]} -gt 0 ] \
    || { sed -n '2,14p' "$0" >&2; exit 2; }

DEBUG_ATTR=""; DEBUG_PROVIDER=""
if [ "$DEBUG" = 1 ]; then
    DEBUG_ATTR='android:debuggable="true"'
    DEBUG_PROVIDER="<provider android:name=\"dev.kiln.KilnVolition\" android:authorities=\"$PACKAGE.volition\" android:exported=\"true\" />"
fi

STAGING="$KILN_ROOT/build/pack/$PACKAGE"
rm -rf "$STAGING"; mkdir -p "$STAGING/classes" "$STAGING/dex"

# Java host -> dex. --release keeps the class files at a level d8 understands.
mapfile -t SOURCES < <(find "$KILN_ROOT/platform/android/java" -name '*.java')
# androidx interfaces kiln implements when the app has them: compiled against, not packaged.
mapfile -t STUBS < <(find "$KILN_ROOT/platform/android/java-stubs" -name '*.java')
mkdir -p "$STAGING/stubs"
javac --release 17 -nowarn -classpath "$ANDROID_JAR" -d "$STAGING/stubs" "${STUBS[@]}"
javac --release 17 -nowarn -classpath "$ANDROID_JAR:$STAGING/stubs" -d "$STAGING/classes" "${SOURCES[@]}"
mapfile -t CLASSES < <(find "$STAGING/classes" -name '*.class')
"$D8" --min-api "$ANDROID_MIN_SDK" --lib "$ANDROID_JAR" --output "$STAGING/dex" "${CLASSES[@]}"
cp "$STAGING/dex/classes.dex" "$STAGING/classes.dex"

PERMISSION_XML=""
for p in "${PERMISSIONS[@]}"; do PERMISSION_XML+="    <uses-permission android:name=\"$p\" />"$'\n'; done
EXTRA_MANIFEST=""; [ -n "$MANIFEST_XML" ] && EXTRA_MANIFEST="$(cat "$MANIFEST_XML")"
EXTRA_APPLICATION=""; [ -n "$APPLICATION_XML" ] && EXTRA_APPLICATION="$(cat "$APPLICATION_XML")"
ICON_ATTR=""
RES_ARGS=()
if [ -n "$ICON" ]; then
    mkdir -p "$STAGING/res/mipmap-xxxhdpi"
    cp "$ICON" "$STAGING/res/mipmap-xxxhdpi/ic_launcher.png"
    "$AAPT2" compile --dir "$STAGING/res" -o "$STAGING/res.zip"
    RES_ARGS=("$STAGING/res.zip")
    ICON_ATTR='android:icon="@mipmap/ic_launcher"'
fi

cat > "$STAGING/AndroidManifest.xml" <<XML
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="$PACKAGE" android:versionCode="$VERSION_CODE" android:versionName="$VERSION_NAME">
$PERMISSION_XML$EXTRA_MANIFEST
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000"
                  android:required="true" />
    <!-- The text toolbar's PROCESS_TEXT activities and Look Up. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.LOOK_UP_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
    <application android:label="$LABEL" $ICON_ATTR android:supportsRtl="true" android:hasCode="true" android:extractNativeLibs="false"
                 android:enableOnBackInvokedCallback="true" $DEBUG_ATTR
                 android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity android:name="dev.kiln.KilnActivity" android:exported="true"
                  android:windowSoftInputMode="adjustResize"
                  android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|navigation|locale|layoutDirection|colorMode|touchscreen|grammaticalGender">
            <meta-data android:name="dev.kiln.lib_name" android:value="$LIBNAME" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        $DEBUG_PROVIDER
$EXTRA_APPLICATION
    </application>
</manifest>
XML

UNSIGNED="$STAGING/unsigned.apk"; ALIGNED="$STAGING/aligned.apk"
ASSET_ARGS=(); [ -n "$ASSETS" ] && ASSET_ARGS=(-A "$ASSETS")
"$AAPT2" link -o "$UNSIGNED" -I "$ANDROID_JAR" --manifest "$STAGING/AndroidManifest.xml" "${ASSET_ARGS[@]}" "${RES_ARGS[@]}" \
    --min-sdk-version "$ANDROID_MIN_SDK" --target-sdk-version "$ANDROID_TARGET_SDK"

ENTRIES=(classes.dex)
for spec in "${LIBS[@]}"; do
    abi="${spec%%=*}"; so="${spec#*=}"
    mkdir -p "$STAGING/lib/$abi"
    "$NDK_TOOLCHAIN/bin/llvm-strip" --strip-unneeded "$so" -o "$STAGING/lib/$abi/lib$LIBNAME.so"
    ENTRIES+=("lib/$abi/lib$LIBNAME.so")
done
# Native libs stay uncompressed and page-aligned so they load in place (extractNativeLibs=false).
python3 "$KILN_ROOT/tools/apkzip.py" "$UNSIGNED" "$STAGING" "${ENTRIES[@]}"
"$ZIPALIGN" -f -P 16 4 "$UNSIGNED" "$ALIGNED"

mkdir -p "$(dirname "$OUT")"
if [ -n "$KEYSTORE_ARG" ]; then
    : "${KILN_KEYSTORE_PASSWORD:?set KILN_KEYSTORE_PASSWORD for $KEYSTORE_ARG}"
    KEYPASS_ENV=KILN_KEY_PASSWORD; [ -n "${KILN_KEY_PASSWORD:-}" ] || KEYPASS_ENV=KILN_KEYSTORE_PASSWORD
    "$APKSIGNER" sign --ks "$KEYSTORE_ARG" --ks-key-alias "${KEY_ALIAS:?--key-alias is needed with --keystore}" \
        --ks-pass env:KILN_KEYSTORE_PASSWORD --key-pass "env:$KEYPASS_ENV" --out "$OUT" "$ALIGNED"
else
    KEYSTORE="$KILN_ROOT/build/kiln-debug.keystore"
    [ -f "$KEYSTORE" ] || keytool -genkeypair -keystore "$KEYSTORE" -alias kiln -keyalg RSA -keysize 2048 \
        -validity 10000 -storepass android -keypass android -dname "CN=kiln debug" >/dev/null 2>&1
    "$APKSIGNER" sign --ks "$KEYSTORE" --ks-key-alias kiln --ks-pass pass:android --key-pass pass:android \
        --out "$OUT" "$ALIGNED"
fi
echo "APK: $OUT ($(du -h "$OUT" | cut -f1))"
