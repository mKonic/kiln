#!/usr/bin/env bash
# kiln-pack: builds an APK from a kiln app's native library without Gradle.
#
#   kiln-pack --package dev.example.app --label "App" --lib-name hello \
#             --lib arm64-v8a=path/libhello.so [--lib x86_64=path/libhello.so] [--assets dir] [--debug] --out app.apk
#
# --debug: a debuggable APK that answers Volition (content://<package>.volition), so the
# volition CLI and MCP tools drive it by name.
# Also: --permission name (repeatable), --icon file.png (the launcher icon, 192 px), --res dir
# (the app's Android res/ folder), --activity-xml file (elements inside the app's <activity>, such
# as intent filters), --activity-attributes 'android:launchMode="singleTop"',
# --application-attributes 'android:networkSecurityConfig="@xml/network"',
# --version-code n, --version-name text, --manifest-xml file / --application-xml file (elements
# added to <manifest> / <application>), --keystore file --key-alias name (sign with your key:
# passwords from KILN_KEYSTORE_PASSWORD and KILN_KEY_PASSWORD; default: kiln's debug key).
#
# --bundle: an Android App Bundle (.aab, what Play takes) instead of an APK: aapt2 links in proto
# format, the base module is laid out as bundletool expects, and jarsigner signs the bundle.
# bundletool comes from KILN_BUNDLETOOL, or is downloaded once to ~/.cache/kiln.
#
# Steps: javac (kiln's Java host, platform APIs only) -> d8 -> manifest -> aapt2 link ->
# add classes.dex + lib/<abi>/*.so -> zipalign -> apksigner (debug key in build/).
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/android-env.sh"
PACKAGE=""; LABEL="kiln app"; LIBNAME=""; OUT=""; LIBS=(); ASSETS=""; DEBUG=0
PERMISSIONS=(); ICON=""; VERSION_CODE=1; VERSION_NAME="1.0"; MANIFEST_XML=""; APPLICATION_XML=""; RES=""; ACTIVITY_XML=""; ACTIVITY_ATTRIBUTES=""; APPLICATION_ATTRIBUTES=""; KEYSTORE_ARG=""; KEY_ALIAS=""; BUNDLE=0
while [ $# -gt 0 ]; do
    case "$1" in
        --package) PACKAGE="$2"; shift 2 ;;
        --label) LABEL="$2"; shift 2 ;;
        --lib-name) LIBNAME="$2"; shift 2 ;;
        --lib) LIBS+=("$2"); shift 2 ;;
        --out) OUT="$2"; shift 2 ;;
        --assets) ASSETS="$2"; shift 2 ;;
        --debug) DEBUG=1; shift ;;
        --permission) PERMISSIONS+=("$2"); shift 2 ;;
        --icon) ICON="$2"; shift 2 ;;
        --version-code) VERSION_CODE="$2"; shift 2 ;;
        --version-name) VERSION_NAME="$2"; shift 2 ;;
        --manifest-xml) MANIFEST_XML="$2"; shift 2 ;;
        --application-xml) APPLICATION_XML="$2"; shift 2 ;;
        --res) RES="$2"; shift 2 ;;
        --activity-xml) ACTIVITY_XML="$2"; shift 2 ;;
        --activity-attributes) ACTIVITY_ATTRIBUTES="$2"; shift 2 ;;
        --application-attributes) APPLICATION_ATTRIBUTES="$2"; shift 2 ;;
        --keystore) KEYSTORE_ARG="$2"; shift 2 ;;
        --bundle) BUNDLE=1; shift ;;
        --key-alias) KEY_ALIAS="$2"; shift 2 ;;
        *) echo "kiln-pack: unknown argument $1" >&2; exit 2 ;;
    esac
done
[ -n "$PACKAGE" ] && [ -n "$LIBNAME" ] && [ -n "$OUT" ] && [ ${#LIBS[@]} -gt 0 ] \
    || { sed -n '2,14p' "$0" >&2; exit 2; }

DEBUG_ATTR=""; DEBUG_PROVIDER=""
if [ "$DEBUG" = 1 ]; then
    DEBUG_ATTR='android:debuggable="true"'
    DEBUG_PROVIDER="<provider android:name=\"dev.kiln.KilnVolition\" android:authorities=\"$PACKAGE.volition\" android:exported=\"true\" />"
fi

STAGING="$KILN_ROOT/build/pack/$PACKAGE"
rm -rf "$STAGING"; mkdir -p "$STAGING/classes" "$STAGING/dex"

# Java host -> dex. --release keeps the class files at a level d8 understands.
mapfile -t SOURCES < <(find "$KILN_ROOT/platform/android/java" -name '*.java')
# androidx interfaces kiln implements when the app has them: compiled against, not packaged.
mapfile -t STUBS < <(find "$KILN_ROOT/platform/android/java-stubs" -name '*.java')
mkdir -p "$STAGING/stubs"
javac --release 17 -nowarn -classpath "$ANDROID_JAR" -d "$STAGING/stubs" "${STUBS[@]}"
javac --release 17 -nowarn -classpath "$ANDROID_JAR:$STAGING/stubs" -d "$STAGING/classes" "${SOURCES[@]}"
mapfile -t CLASSES < <(find "$STAGING/classes" -name '*.class')
"$D8" --min-api "$ANDROID_MIN_SDK" --lib "$ANDROID_JAR" --output "$STAGING/dex" "${CLASSES[@]}"
cp "$STAGING/dex/classes.dex" "$STAGING/classes.dex"

PERMISSION_XML=""
for p in "${PERMISSIONS[@]}"; do PERMISSION_XML+="    <uses-permission android:name=\"$p\" />"$'\n'; done
EXTRA_MANIFEST=""; [ -n "$MANIFEST_XML" ] && EXTRA_MANIFEST="$(cat "$MANIFEST_XML")"
EXTRA_APPLICATION=""; [ -n "$APPLICATION_XML" ] && EXTRA_APPLICATION="$(cat "$APPLICATION_XML")"
EXTRA_ACTIVITY=""; [ -n "$ACTIVITY_XML" ] && EXTRA_ACTIVITY="$(cat "$ACTIVITY_XML")"
ICON_ATTR=""
RES_ARGS=()
# The app's res/ (strings, plurals, drawables...) and the icon, compiled together.
if [ -n "$RES" ]; then
    mkdir -p "$STAGING/res"
    cp -r "$RES"/. "$STAGING/res/"
fi
if [ -n "$ICON" ]; then
    mkdir -p "$STAGING/res/mipmap-xxxhdpi"
    cp "$ICON" "$STAGING/res/mipmap-xxxhdpi/ic_launcher.png"
    ICON_ATTR='android:icon="@mipmap/ic_launcher"'
fi
if [ -d "$STAGING/res" ]; then
    "$AAPT2" compile --dir "$STAGING/res" -o "$STAGING/res.zip"
    RES_ARGS=("$STAGING/res.zip")
fi

cat > "$STAGING/AndroidManifest.xml" <<XML
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="$PACKAGE" android:versionCode="$VERSION_CODE" android:versionName="$VERSION_NAME">
$PERMISSION_XML$EXTRA_MANIFEST
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000"
                  android:required="true" />
    <!-- The text toolbar's PROCESS_TEXT activities and Look Up. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.LOOK_UP_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
    <application android:label="$LABEL" $ICON_ATTR android:supportsRtl="true" android:hasCode="true" android:extractNativeLibs="false"
                 android:enableOnBackInvokedCallback="true" $DEBUG_ATTR $APPLICATION_ATTRIBUTES
                 android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- The OEM window extensions (folds and hinges), where the device has them. -->
        <uses-library android:name="androidx.window.extensions" android:required="false" />
        <uses-library android:name="androidx.window.sidecar" android:required="false" />
        <activity android:name="dev.kiln.KilnActivity" android:exported="true"
                  android:windowSoftInputMode="adjustResize" $ACTIVITY_ATTRIBUTES
                  android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|navigation|locale|layoutDirection|colorMode|touchscreen|grammaticalGender">
            <meta-data android:name="dev.kiln.lib_name" android:value="$LIBNAME" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
$EXTRA_ACTIVITY
        </activity>
        $DEBUG_PROVIDER
$EXTRA_APPLICATION
    </application>
</manifest>
XML

ASSET_ARGS=(); [ -n "$ASSETS" ] && ASSET_ARGS=(-A "$ASSETS")

# The signing key: the app's (--keystore) or kiln's debug key.
if [ -n "$KEYSTORE_ARG" ]; then
    : "${KILN_KEYSTORE_PASSWORD:?set KILN_KEYSTORE_PASSWORD for $KEYSTORE_ARG}"
    KEYPASS_ENV=KILN_KEY_PASSWORD; [ -n "${KILN_KEY_PASSWORD:-}" ] || KEYPASS_ENV=KILN_KEYSTORE_PASSWORD
    SIGN_KS="$KEYSTORE_ARG"; SIGN_ALIAS="${KEY_ALIAS:?--key-alias is needed with --keystore}"
    SIGN_STOREPASS="$KILN_KEYSTORE_PASSWORD"; SIGN_KEYPASS="${!KEYPASS_ENV}"
else
    SIGN_KS="$KILN_ROOT/build/kiln-debug.keystore"; SIGN_ALIAS=kiln; SIGN_STOREPASS=android; SIGN_KEYPASS=android
    [ -f "$SIGN_KS" ] || keytool -genkeypair -keystore "$SIGN_KS" -alias kiln -keyalg RSA -keysize 2048 \
        -validity 10000 -storepass android -keypass android -dname "CN=kiln debug" >/dev/null 2>&1
fi

if [ "$BUNDLE" = 1 ]; then
    BUNDLETOOL_VERSION=1.18.3
    BUNDLETOOL_SHA256=a099cfa1543f55593bc2ed16a70a7c67fe54b1747bb7301f37fdfd6d91028e29
    BUNDLETOOL="${KILN_BUNDLETOOL:-$HOME/.cache/kiln/bundletool-all-$BUNDLETOOL_VERSION.jar}"
    if [ ! -f "$BUNDLETOOL" ]; then
        mkdir -p "$(dirname "$BUNDLETOOL")"
        echo "kiln-pack: downloading bundletool $BUNDLETOOL_VERSION" >&2
        curl -fsSL -o "$BUNDLETOOL.part" "https://github.com/google/bundletool/releases/download/$BUNDLETOOL_VERSION/bundletool-all-$BUNDLETOOL_VERSION.jar"
        echo "$BUNDLETOOL_SHA256  $BUNDLETOOL.part" | sha256sum -c --quiet - || { rm -f "$BUNDLETOOL.part"; echo "kiln-pack: bundletool checksum mismatch" >&2; exit 1; }
        mv "$BUNDLETOOL.part" "$BUNDLETOOL"
    fi
    PROTO="$STAGING/proto.apk"
    "$AAPT2" link --proto-format -o "$PROTO" -I "$ANDROID_JAR" --manifest "$STAGING/AndroidManifest.xml" "${ASSET_ARGS[@]}" "${RES_ARGS[@]}" \
        --min-sdk-version "$ANDROID_MIN_SDK" --target-sdk-version "$ANDROID_TARGET_SDK"
    LIB_SPECS=()
    for spec in "${LIBS[@]}"; do
        abi="${spec%%=*}"; so="${spec#*=}"
        mkdir -p "$STAGING/lib/$abi"
        "$NDK_TOOLCHAIN/bin/llvm-strip" --strip-unneeded "$so" -o "$STAGING/lib/$abi/lib$LIBNAME.so"
        LIB_SPECS+=("lib/$abi/lib$LIBNAME.so")
    done
    # The base module: manifest/, dex/, lib/, res/, assets/ and resources.pb (bundletool's layout).
    python3 - "$PROTO" "$STAGING" "$STAGING/base.zip" "${LIB_SPECS[@]}" <<'PY'
import sys, zipfile
proto, staging, out, libs = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
with zipfile.ZipFile(proto) as src, zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as dst:
    for info in src.infolist():
        name = info.filename
        if name == "AndroidManifest.xml": name = "manifest/AndroidManifest.xml"
        elif not (name == "resources.pb" or name.startswith("res/") or name.startswith("assets/")): name = "root/" + name
        dst.writestr(name, src.read(info.filename))
    dst.write(staging + "/classes.dex", "dex/classes.dex")
    for lib in libs: dst.write(staging + "/" + lib, lib)
PY
    # Native libraries stay uncompressed and 16 KB aligned in the APKs Play makes from it.
    cat > "$STAGING/BundleConfig.json" <<'JSON'
{ "optimizations": { "uncompressNativeLibraries": { "enabled": true, "alignment": "PAGE_ALIGNMENT_16K" } } }
JSON
    rm -f "$STAGING/unsigned.aab"
    java -jar "$BUNDLETOOL" build-bundle --modules="$STAGING/base.zip" --config="$STAGING/BundleConfig.json" --output="$STAGING/unsigned.aab"
    mkdir -p "$(dirname "$OUT")"
    jarsigner -keystore "$SIGN_KS" -storepass "$SIGN_STOREPASS" -keypass "$SIGN_KEYPASS" -sigalg SHA256withRSA -digestalg SHA-256 \
        -signedjar "$OUT" "$STAGING/unsigned.aab" "$SIGN_ALIAS" > "$STAGING/jarsigner.log" 2>&1 \
        || { cat "$STAGING/jarsigner.log" >&2; exit 1; }
    echo "Bundle: $OUT ($(du -h "$OUT" | cut -f1))"
    exit 0
fi

UNSIGNED="$STAGING/unsigned.apk"; ALIGNED="$STAGING/aligned.apk"
"$AAPT2" link -o "$UNSIGNED" -I "$ANDROID_JAR" --manifest "$STAGING/AndroidManifest.xml" "${ASSET_ARGS[@]}" "${RES_ARGS[@]}" \
    --min-sdk-version "$ANDROID_MIN_SDK" --target-sdk-version "$ANDROID_TARGET_SDK"

ENTRIES=(classes.dex)
for spec in "${LIBS[@]}"; do
    abi="${spec%%=*}"; so="${spec#*=}"
    mkdir -p "$STAGING/lib/$abi"
    "$NDK_TOOLCHAIN/bin/llvm-strip" --strip-unneeded "$so" -o "$STAGING/lib/$abi/lib$LIBNAME.so"
    ENTRIES+=("lib/$abi/lib$LIBNAME.so")
done
# Native libs stay uncompressed and page-aligned so they load in place (extractNativeLibs=false).
python3 "$KILN_ROOT/tools/apkzip.py" "$UNSIGNED" "$STAGING" "${ENTRIES[@]}"
"$ZIPALIGN" -f -P 16 4 "$UNSIGNED" "$ALIGNED"

mkdir -p "$(dirname "$OUT")"
if [ -n "$KEYSTORE_ARG" ]; then
    "$APKSIGNER" sign --ks "$SIGN_KS" --ks-key-alias "$SIGN_ALIAS" \
        --ks-pass env:KILN_KEYSTORE_PASSWORD --key-pass "env:$KEYPASS_ENV" --out "$OUT" "$ALIGNED"
else
    "$APKSIGNER" sign --ks "$SIGN_KS" --ks-key-alias kiln --ks-pass pass:android --key-pass pass:android \
        --out "$OUT" "$ALIGNED"
fi
echo "APK: $OUT ($(du -h "$OUT" | cut -f1))"
