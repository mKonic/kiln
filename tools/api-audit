#!/usr/bin/env python3
"""Lists Compose public API that kiln has no counterpart for.

usage: tools/api-audit [--androidx DIR] [module-substring...]

Reads each followed androidx module's api/current.txt (the public API dump, kept in step with the
sources), takes its public, non-deprecated classes and top-level functions and properties, and
prints those no kiln header names (case-insensitively), grouped by module and Kotlin file. A name
that kiln spells differently, or that does not apply (Android views, tooling, Kotlin-only
plumbing), goes in tools/api-audit.toml with the kiln spelling or the reason, so the list only
shows real gaps.
"""
import argparse, os, re, sys, tomllib

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_ANDROIDX = os.path.expanduser("~/dev/os/inspiration/androidx-compose")
# Where kiln's API lives.
HEADER_DIRS = ["include", "core/src", "foundation/src", "material3/src", "navigation/src", "navigation3/src", "render", "platform"]

CLASS = re.compile(r"^  (?P<ann>(?:@[\w.]+(?:\([^)]*\))? )*)public (?:[a-z]+ )*?"
                   r"(?P<kind>class|interface|object|enum|@interface) (?P<name>[\w.]+)")
MEMBER = re.compile(r"^    (?P<what>method|property|field|ctor) (?P<ann>(?:@[\w.]+(?:\([^)]*\))? )*)public (?P<rest>.*)")


def kiln_identifiers():
    ids = set()
    for d in HEADER_DIRS:
        for dirpath, _, files in os.walk(os.path.join(ROOT, d)):
            for f in files:
                if f.endswith((".h", ".hpp")):
                    with open(os.path.join(dirpath, f), errors="replace") as fh:
                        ids.update(w.lower() for w in re.findall(r"[A-Za-z_]\w*", fh.read()))
    return ids


def api_names(path):
    """Yields (group, name): group is the Kotlin file (FooKt) for top-level members, else the class."""
    cls = None          # current class name
    top_level = False   # the class is a FooKt file facade
    with open(path) as f:
        for line in f:
            m = CLASS.match(line)
            if m:
                cls = m.group("name")
                top_level = cls.endswith("Kt") and m.group("kind") == "class"
                deprecated = "@Deprecated" in m.group("ann") or "kotlin.Deprecated" in m.group("ann")
                if not top_level and not deprecated and "." not in cls:
                    yield cls, cls
                elif not top_level and not deprecated and not cls.endswith(".Companion"):
                    yield cls.split(".")[0], cls.replace(".", "::")
                continue
            if not top_level or cls is None:
                continue
            m = MEMBER.match(line)
            if not m or "@Deprecated" in m.group("ann") or "@BytecodeOnly" in m.group("ann"):
                continue
            rest = m.group("rest")
            if m.group("what") == "method":
                if "@InaccessibleFromKotlin" in m.group("ann"):
                    continue   # a property's getter / setter: the property line names it
                nm = re.search(r"(?:^|\s)([\w$-]+)\(", rest)
            elif m.group("what") == "property":
                nm = re.search(r"\s([\w$]+);$", rest)
            else:
                continue
            if nm:
                name = nm.group(1).split("-")[0]   # value-class mangling: padding-qDBjuR0
                if name:
                    yield cls[:-2] + ".kt", name


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--androidx", default=DEFAULT_ANDROIDX)
    ap.add_argument("modules", nargs="*")
    a = ap.parse_args()
    with open(os.path.join(ROOT, "tools", "api-audit.toml"), "rb") as f:
        triage = tomllib.load(f)
    renamed = {k.lower(): v for k, v in triage.get("renamed", {}).items()}
    skipped = {k.lower(): v for k, v in triage.get("skipped", {}).items()}
    patterns = [re.compile(p) for p in triage.get("skipped_patterns", {})]
    modules = triage["modules"]
    ids = kiln_identifiers()
    total = 0
    stale = []
    for module in modules:
        if a.modules and not any(s in module for s in a.modules):
            continue
        path = os.path.join(a.androidx, module, "api", "current.txt")
        if not os.path.exists(path):
            print(f"## {module}: no api/current.txt (add it to the sparse checkout)")
            continue
        missing = {}
        seen = set()
        for group, name in api_names(path):
            key = name.split("::")[-1]
            if (group, key) in seen:
                continue
            seen.add((group, key))
            low = key.lower()
            if low in skipped or any(p.search(key) for p in patterns):
                continue
            if low in renamed:
                if not all(w.lower() in ids for w in re.findall(r"[A-Za-z_]\w*", renamed[low])):
                    stale.append(f"{key} -> {renamed[low]}")
                continue
            if low in ids:
                continue
            missing.setdefault(group, []).append(name)
        n = sum(len(v) for v in missing.values())
        total += n
        if n:
            print(f"## {module}: {n}")
            for group in sorted(missing):
                print(f"- {group}: {', '.join(sorted(set(missing[group])))}")
    if stale:
        print("## renamed entries whose kiln name no header has")
        for s in sorted(set(stale)):
            print(f"- {s}")
    print(f"{total} names without a kiln counterpart")


if __name__ == "__main__":
    main()
