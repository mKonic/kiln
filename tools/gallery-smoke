#!/usr/bin/env python3
"""gallery-smoke [component...]: drives the installed gallery's Material components on a device
with real touches and accessibility actions, one probe run per section (launched alone), and saves screenshots to
look at. Behaviour belongs in kiln_tests (tools/device-test); this checks what only the device
shows: real input, popups in real windows, accessibility, fonts, and how it looks.

Launches: font scale 1.0 left-to-right and 2.0 right-to-left, each in the Light, Dark and Dynamic
themes. Needs $ANDROID_SERIAL; restores the font scale and the app's locales afterwards."""
import os
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / 'build' / 'smoke'
PACKAGE = 'dev.kiln.gallery'

# Each runs on its own gallery section. {p} is the run's screenshot prefix.
COMPONENTS = {
    'navigation': '''expect:Showing: Home; tap:Search; expect:Showing: Search; shot:{p}-navigation; tap:FAB: End;
        expect:FAB: EndOverlay; shot:{p}-navigation-overlay; reach:Labels when selected; tap:Chat; expect:Selected: Chat;
        shot:{p}-navigation-labels; reach:Short: Feed; tap:You; expect:Short: You;
        shot:{p}-navigation-short; reach:Wide: Home; tap:Photos; expect:Wide: Photos;
        tap:Expand rail; expect:Collapse rail; shot:{p}-navigation-wide; reach:Modal: Mail; tap:Open modal rail;
        expect:Close modal rail; tap:Tasks; shot:{p}-navigation-modal; back; expect:Open modal rail; expect:Modal: Tasks;
        reach:Rail: Inbox; tap:Sent; expect:Rail: Sent; tap:Rail labels: always;
        expect:Rail labels: selected; shot:{p}-navigation-rail''',
    'tabs': '''expect:Primary: Flights; tap:Explore; expect:Primary: Explore; tap:Audio; expect:Secondary: Audio;
        tap:Sent; shot:{p}-tabs; tap:Topic 3; expect:Scrolled to: Topic 3; wait:800; tap:Topic 4; expect:Scrolled to: Topic 4;
        wait:800; shot:{p}-tabs-scrolled''',
    'appbars': '''expect:Small top app bar; expect:With a subtitle; reach:Top bar collapsed: 0%; expect:Message 2;
        shot:{p}-appbars; swipeon:Message 3=0,-400,1500; wait:800; expect:Top bar collapsed: 100%; reject:Check; shot:{p}-appbars-collapsed''',
    'toolbars': '''reach:Toolbar expanded: yes; expect:Row 2; expect:More; shot:{p}-toolbars; swipeon:Row 3=0,-300,1500; wait:800;
        expect:Toolbar expanded: no; reject:More; shot:{p}-toolbars-collapsed; reach:Toolbar with FAB expanded: yes; expect:Archive;
        tap:Toggle toolbar; wait:800; expect:Toolbar with FAB expanded: no; reject:Archive; shot:{p}-toolbars-fab''',
    'scrollbars': '''expect:Fading scrollbar; expect:Line 2; shot:{p}-scrollbars; swipeon:Line 4=0,-200,1500; shot:{p}-scrollbars-scrolling;
        wait:1500; shot:{p}-scrollbars-faded; expect:Paragraph 1; expect:Tag 1''',
    'snackbars': '''expect:Snackbar result: none; expect:Sync is paused while offline; tap:Show with action; wait:800; expect:Photo deleted;
        shot:{p}-snackbars; tap:Undo; wait:800; expect:Snackbar result: action; reject:Photo deleted; tap:Show until closed; wait:800;
        expect:Connection lost; shot:{p}-snackbars-indefinite; click:{dismiss}; wait:800; expect:Snackbar result: dismissed''',
    'textfields': '''expect:Flavour: Vanilla; click:Flavour; wait:800; expect:Mint; shot:{p}-textfields-dropdown; click:Mint; wait:800;
        expect:Flavour: Mint; expect:Name: (empty); expect:Email; expect:Price; expect:Password; shot:{p}-textfields; tap:Name; wait:600;
        settext:Name=Ada Lovelace; wait:600; expect:Name: Ada Lovelace; shot:{p}-textfields-typed''',
    'dialogs': '''expect:Dialog result: none; tap:Show alert dialog; wait:800; expect:Reset settings?; shot:{p}-dialogs; tap:Accept; wait:800;
        expect:Dialog result: confirmed; tap:Show alert dialog; wait:800; back; wait:800; expect:Dialog result: outside''',
    'sheets': '''expect:Sheet result: none; tap:Show bottom sheet; wait:1000; expect:Share with; shot:{p}-sheets-modal; tap:Copy link;
        wait:1000; expect:Sheet result: Copy link; reject:Share with; tap:Show bottom sheet; wait:1000; expect:Share with; back; wait:1000;
        expect:Sheet result: dismissed; reject:Share with; reach:Standard sheet: peeking; expect:Nearby places; shot:{p}-sheets-standard;
        swipeon:Nearby places=0,-500,400; wait:1000; expect:Standard sheet: expanded; expect:Station; shot:{p}-sheets-standard-expanded''',
    'drawers': '''expect:Drawer: closed, selected: Inbox; tap:Open drawer; wait:1000; expect:Drawer: open, selected: Inbox; expect:Outbox;
        shot:{p}-drawers-modal; tap:Outbox; wait:1000; expect:Drawer: closed, selected: Outbox; tap:Open drawer; wait:1000;
        expect:Drawer: open, selected: Outbox; back; wait:1000; expect:Drawer: closed, selected: Outbox; swipeon:Dismissible: closed=0,-300,1500; wait:800;
        swipeon:Swipe to reveal={reveal},0,400; wait:1000; expect:Dismissible: open; shot:{p}-drawers-dismissible; back; wait:1000;
        expect:Dismissible: closed''',
    'search': '''expect:Searched: none; tap:Search fruit; wait:1500; expect:Banana; shot:{p}-search-fullscreen; tap:Banana; wait:1500;
        expect:Searched: Banana; reject:Cherry; tap:Search places; wait:1500; expect:Library; shot:{p}-search-docked; back; wait:800; back; wait:1500;
        reject:Library; expect:Searched: Banana''',
    'swipe': '''expect:Swiped: none; expect:Message from Grace; shot:{p}-swipe; swipeon:Message from Ada={reveal},0,300; wait:1000;
        expect:Swiped: Message from Ada archived; reject:Message from Ada; swipeon:Message from Grace={hide},0,300; wait:1000;
        expect:Swiped: Message from Grace deleted; reject:Message from Grace; shot:{p}-swipe-dismissed''',
    'refresh': '''expect:Refreshes: 0; swipeon:Update 2=0,700,600; wait:300; expect:Refreshes: 0 (refreshing); shot:{p}-refresh-refreshing;
        wait:2500; expect:Refreshes: 1; reject:(refreshing); shot:{p}-refresh''',
    'carousel': '''expect:Multi-browse item: 1; expect:Hero item: 1; shot:{p}-carousel; swipeon:Photo 1={hide},0,300; wait:1500;
        reject:Multi-browse item: 1; shot:{p}-carousel-scrolled; reach:Uncontained; shot:{p}-carousel-uncontained''',
    'segmented': '''expect:Single selection: 0; tap:Week; expect:Single selection: 1; tap:Bike; expect:Multiple selection: 3;
        tap:Walk; expect:Multiple selection: 2; shot:{p}-segmented; reach:Disable segments; tap:Disable segments;
        expect:Enable segments; tap:Day; expect:Single selection: 1; shot:{p}-segmented-disabled''',
    'split': '''reach:Filled options; shot:{p}-split; tap:Filled; tap:Filled options; click:Tonal options; click:Elevated options;
        shot:{p}-split-changed; expect:Split open: 11; expect:Split clicks: 1; click:Disable split buttons;
        expect:Enable split buttons; tap:Filled; expect:Split clicks: 1; shot:{p}-split-disabled''',
    'tooltips': '''reach:Plain tooltip anchor; press:Plain tooltip anchor=800; expect:Add to favorites;
        press:Below tooltip anchor=800; expect:Shown below; shot:{p}-tooltip-below; reject:Add to favorites;
        tap:Tooltips; reject:Shown below;
        longclick:Rich tooltip anchor; expect:Camera settings; shot:{p}-tooltip-rich; click:Learn more;
        expect:Tooltip actions: 1; reject:Camera settings; click:Show plain tooltip; expect:Add to favorites''',
    'menus': '''reach:Classic menu; tap:Classic menu; expect:Schedule; expect:Archive; shot:{p}-menu-classic;
        tap:Schedule; expect:Menu choice: Schedule; reject:Archive;
        tap:Expressive menu; expect:Italic; tap:Bold; tap:Right; expect:Menu styles: 1; shot:{p}-menu-expressive;
        back; reject:Italic; expect:Menu align: right''',
    'groups': '''reach:Connected size: 0; tap:Mute; expect:Group styles: 1; tap:{more}; expect:Copy;
        shot:{p}-group-overflow; tap:Copy; expect:Group clicks: 1; reject:Copy; tap:Large;
        expect:Connected size: 2; shot:{p}-groups''',
}
LAUNCHES = (('1.0', 'ltr', ''), ('2.0', 'rtl', 'ar'))
# Labels the framework translates, per launch locale.
STRINGS = {'': {'more': 'More options', 'dismiss': 'Dismiss', 'reveal': '250', 'hide': '-250'},
           'ar': {'more': 'خيارات إضافية', 'dismiss': 'إغلاق', 'reveal': '-250', 'hide': '250'}}
THEMES = ('Light', 'Dark', 'Dynamic')


def adb(*args):
    return subprocess.run(['adb', *args], check=True, capture_output=True, text=True, timeout=120).stdout.strip()


def main():
    if 'ANDROID_SERIAL' not in os.environ:
        sys.exit('set ANDROID_SERIAL to the device to test on')
    names = sys.argv[1:] or list(COMPONENTS)
    unknown = [n for n in names if n not in COMPONENTS]
    if unknown:
        sys.exit('unknown components: ' + ', '.join(unknown) + ' (have ' + ', '.join(COMPONENTS) + ')')
    OUT.mkdir(parents=True, exist_ok=True)
    env = dict(os.environ, PROBE_SHOTS=str(OUT))
    old_scale = adb('shell', 'settings', 'get', 'system', 'font_scale')
    failures = []
    try:
        for scale, direction, locale in LAUNCHES:
            adb('shell', 'settings', 'put', 'system', 'font_scale', scale)
            adb('shell', 'cmd', 'locale', 'set-app-locales', PACKAGE, '--locales', locale)
            for theme in THEMES:
                for name in names:
                    # The section alone (debug.kiln.gallery.section), so the tree stays small.
                    prefix = f'{scale}-{direction}-{theme.lower()}-{name}'
                    steps = f'wait:1000; tap:{theme}; wait:300; ' + ' '.join(COMPONENTS[name].split()).format(p=prefix, **STRINGS[locale])
                    adb('shell', 'setprop', 'debug.kiln.gallery.section', name)
                    adb('shell', 'am', 'force-stop', PACKAGE)
                    adb('shell', 'am', 'start', '-W', '-n', f'{PACKAGE}/dev.kiln.KilnActivity')
                    started = time.monotonic()
                    try:
                        run = subprocess.run([str(ROOT / 'tools/a11y-probe'), steps], env=env, capture_output=True, text=True, timeout=180)
                        log, ok = run.stdout + run.stderr, run.returncode == 0
                    except subprocess.TimeoutExpired as e:
                        log, ok = f'{e.stdout or ""}\nTIMED OUT after 180 s\n', False
                    (OUT / f'{prefix}.txt').write_text(log)
                    failed = next((l for l in log.splitlines() if l.startswith(('FAILED ', 'error:', 'TIMED OUT'))), None)
                    if not ok or failed:
                        failures.append(f'{prefix}: {failed or "probe failed"}')
                    print(f'{prefix}: {"FAILED " + (failed or "") if not ok or failed else "ok"} ({time.monotonic() - started:.0f} s)', flush=True)
    finally:
        adb('shell', 'settings', 'put', 'system', 'font_scale', old_scale if old_scale not in ('', 'null') else '1.0')
        adb('shell', 'cmd', 'locale', 'set-app-locales', PACKAGE, '--locales', '')
        adb('shell', 'setprop', 'debug.kiln.gallery.section', "''")
        adb('shell', 'am', 'force-stop', PACKAGE)
    total = len(LAUNCHES) * len(THEMES) * len(names)
    print(f'{total - len(failures)} of {total} runs passed; logs and screenshots in {OUT}')
    sys.exit(1 if failures else 0)


main()
